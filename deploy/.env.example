# Mikiwa production environment.
# Copy to /home/mikiwa/.env on the server, fill in, chmod 600, owner root.

# --- Required ----------------------------------------------------------------

# Decrypts config/credentials.yml.enc (Mailjet keys, app host, …).
# Take the exact contents of the developer's local config/master.key.
RAILS_MASTER_KEY=

# Used by the OpenAI Vision integration (shopping list photo classification).
OPENAI_API_KEY=

# --- Routing -----------------------------------------------------------------

# Loopback port the web container is published on. nginx proxies to this port.
# Must stay free on the host (see docs/deployment.md §1.6).
MIKIWA_WEB_PORT=8080

# Image tag to deploy. Use `latest` for normal operation, override with
# `sha-XXXXXXX` to roll back to a specific build.
MIKIWA_IMAGE_TAG=latest

# --- Tuning (defaults are sane for a 2 vCPU / 4 GiB box) ---------------------

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
