- content_for :title, "#{@group.name} bearbeiten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= "#{@group.name} bearbeiten"
  .mw-page-header__actions
    = link_to "Abbrechen", groups_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "group_form" }
      = lucide_icon "check", size: 14
      Speichern

.mw-card{ style: "margin-top: 1.5rem; max-width: 520px;" }
  = render "form", group: @group
