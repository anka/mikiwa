- content_for :title, "Notfallkontakt bearbeiten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Notfallkontakt bearbeiten
    %p.mw-page-header__lede
      = @emergency_contact.name
      ·
      = @child.full_name
  .mw-page-header__actions
    = link_to "Abbrechen", child_path(@child), class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "emergency_contact_form" }
      = lucide_icon "check", size: 14
      Speichern

.mw-card{ style: "margin-top: 1.5rem; padding: 24px;" }
  = render "form", emergency_contact: @emergency_contact
