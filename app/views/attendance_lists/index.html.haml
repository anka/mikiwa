- content_for :title, "Teilnahmelisten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Teilnahmelisten
  - if current_user.staff?
    .mw-page-header__actions
      = link_to new_attendance_list_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Neue Liste

- if notice
  .mw-flash.mw-flash--success= notice

- if @lists.any?
  .mw-card{ style: "margin-top: 1.5rem;" }
    %table.mw-table{ style: "width: 100%;" }
      %thead
        %tr
          %th Titel
          %th Gruppe
          %th Modus
          %th Anmeldeschluss
          %th Einträge
          %th{ style: "text-align: right;" } Aktionen
      %tbody
        - @lists.each do |list|
          %tr
            %td
              = link_to list.title, attendance_list_path(list), class: "mw-link"
            %td= list.group.name
            %td
              - if list.mode == "per_date"
                %span.mw-badge.mw-badge--info Pro Datum
              - else
                %span.mw-badge.mw-badge--neutral Allgemein
            %td
              - if list.deadline.present?
                - if list.deadline_passed?
                  %span.mw-text-danger= l(list.deadline, format: :short)
                - else
                  = l(list.deadline, format: :short)
              - else
                %span.mw-text-muted –
            %td= list.attendance_entries.size
            %td{ style: "text-align: right;" }
              .mw-actions
                = link_to attendance_list_path(list), class: "mw-page-action", title: "Öffnen", "aria-label": "Öffnen" do
                  = lucide_icon "eye", size: 14
                - if current_user.staff?
                  = button_to attendance_list_path(list), method: :delete,
                      class: "mw-page-action mw-page-action--danger",
                      title: "Löschen", "aria-label": "Löschen",
                      data: { turbo_confirm: "Liste \"#{list.title}\" wirklich löschen?" } do
                    = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Noch keine Teilnahmelisten angelegt.
    - if current_user.staff?
      = link_to "Erste Liste anlegen", new_attendance_list_path, class: "mw-btn mw-btn--primary mw-btn--sm"
