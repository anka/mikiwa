= form_with model: list, url: list.new_record? ? attendance_lists_path : attendance_list_path(list), class: "mw-form" do |f|
  - if list.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - list.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 3, class: "mw-input"

  .mw-field-row
    .mw-field
      = f.label :group_id, "Gruppe", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, list.group_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true

    .mw-field
      = f.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
      = f.select :kindergarten_year_id,
          options_from_collection_for_select(kindergarten_years, :id, :label, list.kindergarten_year_id),
          {}, class: "mw-select"

  .mw-field
    = f.label :mode, "Modus", class: "mw-field__label"
    = f.select :mode, [ ["Allgemein (Ich/mein Kind kommt)", "general"], ["Pro Datum (Doodle-artig)", "per_date"] ],
        {}, class: "mw-select"

  .mw-field
    = f.label :deadline, "Anmeldeschluss (optional)", class: "mw-field__label"
    = f.datetime_local_field :deadline, class: "mw-input"

  .mw-form__actions
    = f.submit list.new_record? ? "Liste anlegen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", attendance_lists_path, class: "mw-btn mw-btn--ghost"
