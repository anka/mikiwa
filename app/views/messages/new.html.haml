- content_for :title, "Neue Mitteilung · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Neue Mitteilung verfassen
  .mw-page-header__actions
    = link_to "Abbrechen", messages_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "message_form" }
      = lucide_icon "send", size: 14
      Versenden

= form_with model: @message, url: messages_path, class: "mw-form", html: { id: "message_form" } do |f|
  - if @message.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - @message.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Betreff", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field
    %label.mw-field__label Empfänger-Gruppen
    .mw-checkbox-group
      - @groups.each do |group|
        .mw-checkbox-row
          = check_box_tag "message[group_ids][]", group.id, false,
              id: "group_#{group.id}", class: "mw-checkbox"
          = label_tag "group_#{group.id}", group.name, class: "mw-field__label mw-field__label--inline"

  .mw-field
    = f.label :body, "Inhalt", class: "mw-field__label"
    = f.text_area :body, rows: 8, required: true, class: "mw-input"

  .mw-field
    = f.label :attachment, "Anhang (optional)", class: "mw-field__label"
    = f.file_field :attachment, class: "mw-input"

