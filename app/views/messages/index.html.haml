- content_for :title, "Gesendete Mitteilungen · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Gesendete Mitteilungen
  .mw-page-header__actions
    = link_to new_message_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
      = lucide_icon "plus", size: 16
      Neue Mitteilung

- if notice
  .mw-flash.mw-flash--success= notice

- if @messages.any?
  .mw-card{ style: "margin-top: 1.5rem;" }
    %table.mw-table{ style: "width: 100%;" }
      %thead
        %tr
          %th Betreff
          %th Gruppen
          %th Empfänger
          %th Versandt am
          %th{ style: "text-align: right;" } Aktionen
      %tbody
        - @messages.each do |msg|
          %tr
            %td= link_to msg.title, message_path(msg), class: "mw-link"
            %td= msg.groups.map(&:name).join(", ")
            %td= msg.inbox_entries.count
            %td= l(msg.created_at, format: :short)
            %td{ style: "text-align: right;" }
              = button_to message_path(msg), method: :delete,
                  class: "mw-page-action mw-page-action--danger", title: "Löschen",
                  data: { turbo_confirm: "Mitteilung \"#{msg.title}\" wirklich löschen?" } do
                = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Noch keine Mitteilungen versandt.
    = link_to "Erste Mitteilung verfassen", new_message_path, class: "mw-btn mw-btn--primary mw-btn--sm"
