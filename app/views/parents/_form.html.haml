= form_with model: user, url: form_url, method: form_method, class: "mw-form", html: { id: "parent_form" } do |form|
  - if user.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - user.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = form.label :email, class: "mw-field__label" do
      | E-Mail-Adresse
      %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
    = form.email_field :email, required: true, autofocus: true, class: "mw-input", placeholder: "name@example.at"

  .mw-field
    = form.label :first_name, class: "mw-field__label" do
      | Vorname
      %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
    = form.text_field :first_name, required: true, class: "mw-input"

  .mw-field
    = form.label :last_name, class: "mw-field__label" do
      | Nachname
      %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
    = form.text_field :last_name, required: true, class: "mw-input"

  .mw-field
    = form.label :phone, class: "mw-field__label" do
      | Telefonnummer
      %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
    = form.telephone_field :phone, required: true, class: "mw-input", placeholder: "0664 123 456"

  .mw-field
    = form.label :knowhow, "Wissen / Fähigkeiten", class: "mw-field__label"
    = form.text_area :knowhow, class: "mw-input", rows: 3,
        placeholder: "z. B. Tischler, kann Bastel-AGs unterstützen"
    %p.mw-field__hint Optional, hilft Betreuer:innen bei der Planung gemeinsamer Aktivitäten.

  .mw-field
    = form.label :notes, "Anmerkung", class: "mw-field__label"
    = form.text_area :notes, class: "mw-input", rows: 3,
        placeholder: "Interne Notizen zu diesem Eltern-Account"
    %p.mw-field__hint Nur intern sichtbar.
