= form_with model: gruppe, url: gruppe.new_record? ? gruppen_index_path : gruppen_path(gruppe), class: "mw-form" do |form|
  - if gruppe.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - gruppe.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = form.label :name, "Name", class: "mw-field__label"
    = form.text_field :name, required: true, autofocus: true, class: "mw-input", placeholder: "z.B. Schmetterlinge"

  .mw-field
    = form.label :farbe, "Akzentfarbe (optional)", class: "mw-field__label"
    .mw-color-row
      = form.color_field :farbe, class: "mw-color-picker"
      %span.mw-field__hint Wird als Farbakzent in Listen und Ansichten verwendet.

  .mw-field
    = form.label :beschreibung, "Kurzbeschreibung (optional)", class: "mw-field__label"
    = form.text_area :beschreibung, rows: 3, class: "mw-input", placeholder: "Altersgruppe, Besonderheiten, …"

  .mw-form__actions
    = form.submit gruppe.new_record? ? "Gruppe anlegen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", gruppen_index_path, class: "mw-btn mw-btn--ghost"
