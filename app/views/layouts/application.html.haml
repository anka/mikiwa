!!!
%html{ lang: "de", "data-theme": "light" }
  %head
    %meta{ "http-equiv": "Content-Type", content: "text/html; charset=UTF-8" }/
    %title= content_for(:title) || "Mikiwa"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }/
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }/
    %meta{ name: "application-name", content: "Mikiwa" }/
    %meta{ name: "mobile-web-app-capable", content: "yes" }/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    -# F28: Theme-Boot vor Stylesheet rendern – verhindert Flash of Light Theme
    = javascript_tag nonce: true do
      :plain
        (function () {
          try {
            var stored = localStorage.getItem("mikiwa.theme");
            var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            var theme = stored || (prefersDark ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", theme);
            window.__themeBoot = theme;
          } catch (e) {}
        })();
    %link{ rel: "icon", type: "image/png", href: "/icons/icon-192.png" }/
    %link{ rel: "icon", type: "image/svg+xml", href: "/icon.svg" }/
    %link{ rel: "apple-touch-icon", href: "/icons/icon-192.png" }/
    %link{ rel: "manifest", href: "/manifest.json" }/
    %meta{ name: "theme-color", content: "#c4971e" }/
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body
    .mw-app-shell
      .mw-drawer{ "data-controller": "drawer", "data-open": "false" }
        %header.mw-app-topbar
          - if authenticated?
            %button.mw-burger{ type: "button",
                               "aria-label": "Hauptmenü öffnen",
                               "aria-expanded": "false",
                               "data-drawer-target": "trigger",
                               "data-action": "click->drawer#toggle" }
              = lucide_icon "menu", size: 22
          = link_to root_path, class: "mw-app-brand", "aria-label": "Mikiwa" do
            = image_tag "mikiwa/logo-mikiwa.svg", class: "mw-app-brand__mark", alt: ""
            %span.mw-app-brand__wordmark mikiwa
          .mw-app-topbar__spacer
          %button.mw-theme-toggle{ type: "button",
                                   "aria-label": "Theme wechseln",
                                   "data-controller": "theme",
                                   "data-action": "click->theme#toggle" }
            %span.mw-theme-toggle__icon{ "data-theme-target": "icon" }
              %span.mw-theme-toggle__sun
                = lucide_icon "sun", size: 18
              %span.mw-theme-toggle__moon
                = lucide_icon "moon", size: 18
          - unless authenticated?
            = link_to "Anmelden", new_session_path, class: "mw-btn mw-btn--primary mw-btn--sm"

        .mw-app-body
          - if authenticated?
            -# Sidebar – auf Mobile als Drawer-Panel
            .mw-drawer__panel{ "data-drawer-target": "panel",
                               "data-action": "click->drawer#closeOnLink" }
              = render "layouts/navigation"
            .mw-drawer__scrim{ "data-drawer-target": "scrim",
                               "data-action": "click->drawer#close" }

          %main.mw-app-main{ id: "main-content" }
            - if content_for?(:no_container)
              = yield
            - else
              .mw-container
                = yield

        - if authenticated?
          = render "layouts/mobile_nav"
