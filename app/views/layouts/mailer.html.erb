<!DOCTYPE html>
<html lang="de">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= content_for(:title) || "Mikiwa" %></title>
  </head>
  <body style="margin:0;padding:0;background:#FBF7EE;font-family:'Nunito',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#3A2F22;-webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FBF7EE;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#FFFFFF;border:1px solid #EFE7D6;border-radius:16px;overflow:hidden;box-shadow:0 1px 2px rgba(80,60,30,0.04),0 4px 12px rgba(80,60,30,0.06);">
            <tr>
              <td style="background:#FBF7EE;padding:28px 32px;border-bottom:1px solid #EFE7D6;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="vertical-align:middle;padding-right:12px;">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="36" height="36" role="img" aria-label="Mikiwa">
                        <defs>
                          <g id="petal">
                            <path d="M0 -36 C 10 -34, 14 -22, 8 -10 C 4 -4, -4 -4, -8 -10 C -14 -22, -10 -34, 0 -36 Z"></path>
                          </g>
                        </defs>
                        <g transform="translate(60 60)">
                          <use href="#petal" fill="#F4C95D" transform="rotate(0)"></use>
                          <use href="#petal" fill="#A9D08E" transform="rotate(45)"></use>
                          <use href="#petal" fill="#8FBFE0" transform="rotate(90)"></use>
                          <use href="#petal" fill="#E8A87C" transform="rotate(135)"></use>
                          <use href="#petal" fill="#F4C95D" transform="rotate(180)"></use>
                          <use href="#petal" fill="#A9D08E" transform="rotate(225)"></use>
                          <use href="#petal" fill="#8FBFE0" transform="rotate(270)"></use>
                          <use href="#petal" fill="#E8A87C" transform="rotate(315)"></use>
                          <circle r="14" fill="#7A4A20"></circle>
                          <circle r="14" fill="none" stroke="#5A3815" stroke-width="1.5"></circle>
                        </g>
                      </svg>
                    </td>
                    <td style="vertical-align:middle;">
                      <span style="font-family:'Nunito',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-weight:800;font-size:24px;color:#2A1F12;letter-spacing:-0.02em;">mikiwa</span>
                      <div style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:#8A7460;text-transform:uppercase;margin-top:2px;">Mit Kindern wachsen</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;background:#FFFFFF;font-size:16px;line-height:1.65;color:#3A2F22;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="background:#FBF7EE;padding:20px 32px;border-top:1px solid #EFE7D6;font-size:12px;line-height:1.5;color:#8A7460;">
                MIKIWA &middot; Gurktalerstrasse 16 &middot; 9560 Feldkirchen in K&auml;rnten<br>
                Diese Nachricht wurde automatisch von Mikiwa versendet.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
