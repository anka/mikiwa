%nav.mw-mobile-nav{ "aria-label": "Mobile Navigation" }
  - if current_user.parent?
    = link_to parent_dashboard_path, class: "mw-mobile-nav__item #{nav_active?('/dashboard/parent')}" do
      = lucide_icon "home", size: 22
      %span Übersicht
    = link_to shopping_lists_path, class: "mw-mobile-nav__item #{nav_active?('/shopping_lists')}" do
      = lucide_icon "shopping-cart", size: 22
      %span Einkauf
    = link_to inbox_path, class: "mw-mobile-nav__item #{nav_active?('/inbox')}" do
      = lucide_icon "inbox", size: 22
      %span Posteingang
    = link_to calendar_events_path, class: "mw-mobile-nav__item #{nav_active?('/calendar_events')}" do
      = lucide_icon "calendar", size: 22
      %span Kalender
  - else
    = link_to staff_dashboard_path, class: "mw-mobile-nav__item #{nav_active?('/dashboard/staff')}" do
      = lucide_icon "home", size: 22
      %span Übersicht
    = link_to attendances_path, class: "mw-mobile-nav__item #{nav_active?('/attendances')}" do
      = lucide_icon "calendar-check", size: 22
      %span Anwesenheit
    = link_to meal_entries_path, class: "mw-mobile-nav__item #{nav_active?('/meal_entries')}" do
      = lucide_icon "utensils", size: 22
      %span Speiseplan
    = link_to messages_path, class: "mw-mobile-nav__item #{nav_active?('/messages')}" do
      = lucide_icon "send", size: 22
      %span Mitteilungen
