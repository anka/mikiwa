%nav.mw-mobile-nav{ "aria-label": "Mobile Navigation" }
  - if current_user.parent?
    = link_to inbox_path, class: "mw-mobile-nav__item #{nav_active?('/inbox')}" do
      = lucide_icon "inbox", size: 22
      %span Posteingang
    = link_to events_path, class: "mw-mobile-nav__item #{nav_active?('/events')}" do
      = lucide_icon "calendar-days", size: 22
      %span Veranstaltungen
    = link_to calendar_events_path, class: "mw-mobile-nav__item #{nav_active?('/calendar_events')}" do
      = lucide_icon "calendar", size: 22
      %span Kalender
    = link_to children_path, class: "mw-mobile-nav__item #{nav_active?('/children')}" do
      = lucide_icon "users", size: 22
      %span Kinder
  - else
    = link_to children_path, class: "mw-mobile-nav__item #{nav_active?('/children')}" do
      = lucide_icon "users", size: 22
      %span Kinder
    = link_to calendar_events_path, class: "mw-mobile-nav__item #{nav_active?('/calendar_events')}" do
      = lucide_icon "calendar", size: 22
      %span Kalender
    = link_to groups_path, class: "mw-mobile-nav__item #{nav_active?('/groups')}" do
      = lucide_icon "layout-grid", size: 22
      %span Gruppen
    = link_to messages_path, class: "mw-mobile-nav__item #{nav_active?('/messages')}" do
      = lucide_icon "send", size: 22
      %span Mitteilungen
  = link_to profile_path, class: "mw-mobile-nav__item #{nav_active?('/profile')}" do
    = lucide_icon "user", size: 22
    %span Profil
