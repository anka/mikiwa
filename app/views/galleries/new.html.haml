- content_for :title, "Neue Galerie · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Neue Galerie
  .mw-page-header__actions
    = link_to "Abbrechen", galleries_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "gallery_form" }
      = lucide_icon "check", size: 14
      Speichern

= render "form", gallery: @gallery, groups: @groups,
    kindergarten_years: @kindergarten_years, events: @events
