= form_with model: gallery, url: gallery.new_record? ? galleries_path : gallery_path(gallery), class: "mw-form", html: { id: "gallery_form" } do |f|
  - if gallery.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - gallery.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field
    %label.mw-field__label Gruppen
    .mw-checkbox-group
      - groups.each do |group|
        .mw-checkbox-row
          = check_box_tag "gallery[group_ids][]", group.id,
              gallery.groups.include?(group),
              id: "group_#{group.id}", class: "mw-checkbox"
          = label_tag "group_#{group.id}", group.name, class: "mw-field__label mw-field__label--inline"

  .mw-field-row
    .mw-field
      = f.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
      = f.select :kindergarten_year_id,
          options_from_collection_for_select(kindergarten_years, :id, :label, gallery.kindergarten_year_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true
    .mw-field
      = f.label :event_date, "Datum (optional)", class: "mw-field__label"
      = f.date_field :event_date, class: "mw-input"

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 3, class: "mw-input"

  - if events.any?
    .mw-field
      = f.label :event_id, "Verknüpfte Veranstaltung (optional)", class: "mw-field__label"
      = f.select :event_id,
          options_from_collection_for_select(events, :id, :title, gallery.event_id),
          { include_blank: "Keine" }, class: "mw-select"

  - slideshow_speed_options = [ [ "Langsam (8 Sekunden pro Bild)", "slow" ], [ "Normal (4 Sekunden pro Bild)", "normal" ], [ "Schnell (2 Sekunden pro Bild)", "fast" ] ]
  .mw-field
    = f.label :slideshow_speed, "Slideshow-Geschwindigkeit", class: "mw-field__label"
    = f.select :slideshow_speed, slideshow_speed_options, {}, class: "mw-select"

  .mw-field
    = f.label :audio, "Begleitmusik (optional)", class: "mw-field__label"
    - if gallery.audio.attached? && gallery.audio.blob&.persisted?
      .mw-audio-attached
        %audio.mw-audio-attached__player{ controls: true, src: url_for(gallery.audio) }
        -# kein button_to im äußeren form_with (HTML erlaubt keine
        -# verschachtelten <form>; sonst submittet 'Entfernen' den
        -# Outer-Edit-PATCH statt /audio DELETE).
        = link_to purge_audio_gallery_path(gallery),
            class: "mw-btn mw-btn--ghost mw-btn--sm",
            data: { turbo_method: :delete, turbo_confirm: "Begleitmusik entfernen?" } do
          = lucide_icon "trash-2", size: 14
          Entfernen
    = f.file_field :audio, accept: "audio/mpeg,audio/mp4,audio/x-m4a", class: "mw-input"
    %small.mw-field__hint MP3 oder M4A, max. 25 MB

  .mw-field
    .mw-checkbox-row
      = f.check_box :visibility, { id: "gallery_visibility_released", class: "mw-checkbox" },
          "released", "internal"
      = f.label :visibility, "Sofort freigeben (für Eltern sichtbar)", class: "mw-field__label mw-field__label--inline", for: "gallery_visibility_released"

