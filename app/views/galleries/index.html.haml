- content_for :title, "Bildergalerien · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Bildergalerien
  - if current_user.staff?
    .mw-page-header__actions
      = link_to new_gallery_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Neue Galerie

- if notice
  .mw-flash.mw-flash--success= notice

- if @galleries.any?
  .mw-gallery-grid{ style: "margin-top: 1.5rem;" }
    - @galleries.each do |gallery|
      .mw-gallery-card
        - cover_photo = gallery.photos.in_order.with_attached_image.first
        .mw-gallery-card__cover
          - if cover_photo&.image&.attached?
            = image_tag cover_photo.image.variant(:thumb),
                loading: "lazy", alt: "", class: "mw-gallery-card__img"
          - else
            .mw-gallery-card__placeholder
              = lucide_icon "image", size: 32
        .mw-gallery-card__body
          %h2.mw-gallery-card__title= link_to gallery.title, gallery_path(gallery), class: "mw-link mw-link--unstyled"
          - photo_count = gallery.photos.size
          %p.mw-gallery-card__meta
            = gallery.groups.map(&:name).join(", ")
            ·
            = photo_count
            = photo_count == 1 ? "Bild" : "Bilder"
            - if current_user.staff?
              ·
              - if gallery.released?
                %span.mw-badge.mw-badge--success Freigegeben
              - else
                %span.mw-badge.mw-badge--warning Intern
          .mw-gallery-card__actions
            = link_to gallery_path(gallery), class: "mw-page-action",
                title: "Öffnen", "aria-label": "Öffnen" do
              = lucide_icon "eye", size: 14
            - if current_user.staff?
              = button_to gallery_path(gallery), method: :delete,
                  class: "mw-page-action mw-page-action--danger",
                  title: "Löschen", "aria-label": "Löschen",
                  data: { turbo_confirm: "Galerie \"#{gallery.title}\" wirklich löschen?" } do
                = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Noch keine Bildergalerien angelegt.
    - if current_user.staff?
      = link_to "Erste Galerie anlegen", new_gallery_path, class: "mw-btn mw-btn--primary mw-btn--sm"
