<% content_for :title, "Anmelden · Mikiwa" %>

<h1 class="mw-auth-card__title">Anmelden</h1>
<p class="mw-auth-card__lede">Willkommen zurück. Bitte melden Sie sich mit Ihrer E-Mail-Adresse und Ihrem Passwort an.</p>

<%= form_with url: session_path, class: "mw-auth-form" do |form| %>
  <div class="mw-field">
    <%= form.label :email, "E-Mail-Adresse", class: "mw-field__label" %>
    <%= form.email_field :email,
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "name@example.at",
          value: params[:email],
          class: "mw-input" %>
  </div>

  <div class="mw-field">
    <%= form.label :password, "Passwort", class: "mw-field__label" %>
    <%= form.password_field :password,
          required: true,
          autocomplete: "current-password",
          placeholder: "Ihr Passwort",
          maxlength: 72,
          class: "mw-input" %>
  </div>

  <%= form.submit "Anmelden", class: "mw-btn mw-btn--primary mw-btn--block mw-btn--lg" %>
<% end %>

<p class="mw-auth-footer">
  <%= link_to "Passwort vergessen?", new_password_path %>
</p>
