= form_with model: poll, url: poll.new_record? ? abstimmungen_path : abstimmung_path(poll), class: "mw-form" do |f|
  - if poll.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - poll.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field-row
    .mw-field
      = f.label :poll_type, "Typ", class: "mw-field__label"
      = f.select :poll_type,
          [["Einfachauswahl", "einfach"], ["Mehrfachauswahl", "mehrfach"]],
          {}, class: "mw-select"
    .mw-field
      = f.label :group_id, "Gruppe", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, poll.group_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true

  .mw-field-row
    .mw-field
      = f.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
      = f.select :kindergarten_year_id,
          options_from_collection_for_select(kindergarten_years, :id, :label, poll.kindergarten_year_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true
    .mw-field
      = f.label :deadline, "Stimmschluss (optional)", class: "mw-field__label"
      = f.datetime_local_field :deadline, class: "mw-input"

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 3, class: "mw-input"

  - if events.any?
    .mw-field
      = f.label :event_id, "Verknüpfte Veranstaltung (optional)", class: "mw-field__label"
      = f.select :event_id,
          options_from_collection_for_select(events, :id, :title, poll.event_id),
          { include_blank: "Keine" }, class: "mw-select"

  .mw-field
    %label.mw-field__label Optionen
    = f.fields_for :abstimmung_optionen do |opt_f|
      .mw-shopping-form-row
        = opt_f.text_field :label, class: "mw-input mw-input--sm", placeholder: "Bezeichnung"
        = opt_f.hidden_field :position
        = opt_f.check_box :_destroy, class: "mw-checkbox", id: "destroy_opt_#{opt_f.object.object_id}"
        = opt_f.label :_destroy, "Entfernen", class: "mw-field__label mw-field__label--inline"

  .mw-form__actions
    = f.submit poll.new_record? ? "Abstimmung anlegen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", abstimmungen_path, class: "mw-btn mw-btn--ghost"
