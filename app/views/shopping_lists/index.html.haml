- content_for :title, "Einkaufslisten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Einkaufslisten
  - if current_user.staff?
    .mw-page-header__actions
      = link_to new_shopping_list_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Neue Liste

- if notice
  .mw-flash.mw-flash--success= notice

.mw-shopping-list-filters{ style: "margin-top: 1rem; display: flex; gap: 0.5rem;" }
  - all_class = @assigned_filter == "me" ? "mw-btn--secondary" : "mw-btn--primary"
  - me_class  = @assigned_filter == "me" ? "mw-btn--primary"   : "mw-btn--secondary"
  = link_to "Alle", shopping_lists_path, class: "mw-btn mw-btn--sm #{all_class}"
  = link_to "Nur mir zugewiesen", shopping_lists_path(assigned: "me"), class: "mw-btn mw-btn--sm #{me_class}"

= form_with url: shopping_lists_path, method: :get, local: true, class: "mw-shopping-lists-filters", html: { style: "margin-top: 1rem;" } do
  .mw-shopping-lists-filters__row{ style: "display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; align-items: end;" }
    .mw-form__field
      %label.mw-form__label{ for: "filter-group-id" } Gruppe
      = select_tag :group_id,
                   options_from_collection_for_select(@filter_groups, :id, :name, @filter_group_id),
                   include_blank: "Alle Gruppen", id: "filter-group-id", class: "mw-form__input"
    .mw-form__field
      %label.mw-form__label{ for: "filter-month" } Monat
      = select_tag :month,
                   options_for_select(@filter_months.map { |m| [ I18n.l(Date.parse("#{m}-01"), format: "%B %Y"), m ] }, @filter_month),
                   include_blank: "Alle Monate", id: "filter-month", class: "mw-form__input"
    .mw-form__field
      %label.mw-form__label{ for: "filter-assigned-to" } Verantwortlich
      = select_tag :assigned_to_id,
                   options_from_collection_for_select(@filter_assignees, :id, ->(u) { u.full_name.presence || u.email }, @filter_assigned_to_id),
                   include_blank: "Alle", id: "filter-assigned-to", class: "mw-form__input"
    .mw-form__field
      = submit_tag "Filtern", class: "mw-btn mw-btn--secondary mw-btn--sm"
  - if @filter_group_id.present? || @filter_month.present? || @filter_assigned_to_id.present?
    .mw-shopping-lists-filters__reset{ style: "margin-top: 8px; text-align: right;" }
      = link_to "Filter zurücksetzen", shopping_lists_path, class: "mw-page-action"

- if @lists.any?
  .mw-card{ style: "margin-top: 1rem;" }
    %table.mw-table.mw-table--cards{ style: "width: 100%;" }
      %thead
        %tr
          %th Titel
          %th Gruppe
          %th Verantwortlich
          %th Einkaufstag
          %th KW
          %th Einträge
          %th{ style: "text-align: right;" } Aktionen
      %tbody
        - @lists.each do |list|
          - total  = list.shopping_items.size
          - done   = list.shopping_items.count(&:done?)
          %tr
            %td{ "data-label": "Titel" }= link_to list.title, shopping_list_path(list), class: "mw-link"
            %td{ "data-label": "Gruppe" }
              - if list.group.present?
                %span.mw-badge.mw-badge--neutral= list.group.name
              - else
                %span.mw-badge.mw-badge--accent Kindergarten
            %td{ "data-label": "Verantwortlich" }
              - if list.assigned_to.present?
                = list.assigned_to.full_name.presence || list.assigned_to.email
              - else
                %span.mw-badge.mw-badge--neutral Nicht zugewiesen
            %td{ "data-label": "Einkaufstag" }= l(list.event_date, format: :long)
            %td{ "data-label": "KW" }= list.calendar_week_label
            %td{ "data-label": "Einträge" }
              %span{ style: done == total && total > 0 ? "color: var(--success);" : nil }
                = "#{done}/#{total} erledigt"
            %td{ "data-label": "Aktionen", style: "text-align: right;" }
              .mw-actions
                = link_to shopping_list_path(list), class: "mw-page-action", title: "Öffnen", "aria-label": "Öffnen" do
                  = lucide_icon "eye", size: 14
                - if current_user.staff?
                  = button_to shopping_list_path(list), method: :delete,
                      class: "mw-page-action mw-page-action--danger",
                      title: "Löschen", "aria-label": "Löschen",
                      data: { turbo_confirm: "Liste \"#{list.title}\" wirklich löschen?" } do
                    = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Keine Einkaufslisten vorhanden.
    - if current_user.staff?
      = link_to "Erste Liste anlegen", new_shopping_list_path, class: "mw-btn mw-btn--primary mw-btn--sm"
