- content_for :title, "Einkaufslisten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Einkaufslisten
  - if current_user.staff?
    .mw-page-header__actions
      = link_to new_shopping_list_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Neue Liste

- if notice
  .mw-flash.mw-flash--success= notice

.mw-shopping-list-filters{ style: "margin-top: 1rem; display: flex; gap: 0.5rem;" }
  - all_class = @assigned_filter == "me" ? "mw-btn--secondary" : "mw-btn--primary"
  - me_class  = @assigned_filter == "me" ? "mw-btn--primary"   : "mw-btn--secondary"
  = link_to "Alle", shopping_lists_path, class: "mw-btn mw-btn--sm #{all_class}"
  = link_to "Nur mir zugewiesen", shopping_lists_path(assigned: "me"), class: "mw-btn mw-btn--sm #{me_class}"

- if @lists.any?
  .mw-card{ style: "margin-top: 1rem;" }
    %table.mw-table{ style: "width: 100%;" }
      %thead
        %tr
          %th Titel
          %th Gruppe
          %th Verantwortlich
          %th Datum
          %th Einträge
          %th{ style: "text-align: right;" } Aktionen
      %tbody
        - @lists.each do |list|
          - total  = list.shopping_items.size
          - done   = list.shopping_items.count(&:done?)
          %tr
            %td= link_to list.title, shopping_list_path(list), class: "mw-link"
            %td
              - if list.group.present?
                %span.mw-badge.mw-badge--neutral= list.group.name
              - else
                %span.mw-badge.mw-badge--accent Kindergarten
            %td
              - if list.assigned_to.present?
                = list.assigned_to.full_name.presence || list.assigned_to.email
              - else
                %span.mw-badge.mw-badge--neutral Nicht zugewiesen
            %td= l(list.event_date, format: :long)
            %td
              %span{ style: done == total && total > 0 ? "color: var(--success);" : nil }
                = "#{done}/#{total} erledigt"
            %td{ style: "text-align: right;" }
              .mw-actions
                = link_to shopping_list_path(list), class: "mw-btn mw-btn--secondary mw-btn--sm" do
                  Öffnen
                - if current_user.staff?
                  = button_to shopping_list_path(list), method: :delete,
                      class: "mw-page-action mw-page-action--danger", title: "Löschen",
                      data: { turbo_confirm: "Liste \"#{list.title}\" wirklich löschen?" } do
                    = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Keine Einkaufslisten vorhanden.
    - if current_user.staff?
      = link_to "Erste Liste anlegen", new_shopping_list_path, class: "mw-btn mw-btn--primary mw-btn--sm"
