- content_for :title, "#{@list.title} bearbeiten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Einkaufsliste bearbeiten
    %p.mw-page-header__lede Pflege Stammdaten und Einträge dieser Liste.
  .mw-page-header__actions
    = link_to shopping_list_path(@list), class: "mw-page-action" do
      = lucide_icon "image", size: 14
      Vorschau
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "shopping_list_form" }
      = lucide_icon "check", size: 14
      Speichern
    = link_to "Zurück", shopping_lists_path, class: "mw-page-action"

- if notice
  .mw-flash.mw-flash--success= notice

.mw-shopping-editor
  -# F82: Stammdaten-Card auf Mobile kollabierbar (Default zu), auf Desktop via CSS immer offen.
  %section.mw-card.mw-shopping-editor__metadata{ data: { controller: "collapse" } }
    %button.mw-shopping-editor__section-header.mw-shopping-editor__metadata-toggle{ type: "button",
                                                                                    "aria-expanded": "false",
                                                                                    data: { "collapse-target": "trigger",
                                                                                            action: "click->collapse#toggle" } }
      %h2.mw-shopping-editor__section-title Stammdaten
      %span.mw-shopping-editor__metadata-chevron
        = lucide_icon "chevron-down", size: 18
    .mw-shopping-editor__metadata-body{ data: { "collapse-target": "body" }, hidden: true }
      = render "form", list: @list, groups: @groups, kindergarten_years: @kindergarten_years, eligible_parents: @eligible_parents

  %section.mw-card{ id: "shopping_items_card" }
    %header.mw-shopping-editor__section-header
      %h2.mw-shopping-editor__section-title Einträge
      #shopping_items_summary
        = render "shopping_items/summary", list: @list

    %ul#shopping_items.mw-shopping-editor__list
      - @items.each do |item|
        = render "shopping_items/item", item: item, mode: :edit

    = render "shopping_items/form", list: @list, item: @new_item
