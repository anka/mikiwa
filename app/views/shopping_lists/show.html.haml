- content_for :title, "#{@list.title} · Einkaufsliste · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @list.title
    %p.mw-page-header__lede
      = @list.group.name
      ·
      = l(@list.event_date, format: :long)
  .mw-page-header__actions
    - if current_user.staff?
      = link_to edit_shopping_list_path(@list), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
    = link_to shopping_lists_path, class: "mw-btn mw-btn--ghost mw-btn--sm" do
      Zurück

- if notice
  .mw-flash.mw-flash--success= notice

-# Filter "nur offen"
.mw-calendar-filters{ style: "margin-top: 1rem;" }
  - if @open_only
    = link_to shopping_list_path(@list), class: "mw-btn mw-btn--secondary mw-btn--sm" do
      = lucide_icon "list", size: 14
      Alle anzeigen
  - else
    = link_to shopping_list_path(@list, filter: "open"), class: "mw-btn mw-btn--secondary mw-btn--sm" do
      = lucide_icon "filter", size: 14
      Nur offene

-# Einkaufsliste – mobile-optimiert
.mw-shopping-list{ style: "margin-top: 1rem;" }
  - if @items.any?
    - @items.each do |item|
      .mw-shopping-item{ class: item.done? ? "mw-shopping-item--done" : nil }
        .mw-shopping-item__check
          - if item.done?
            = button_to uncomplete_shopping_list_shopping_item_path(@list, item), method: :patch,
                class: "mw-shopping-item__btn mw-shopping-item__btn--done",
                "aria-label": "Als offen markieren" do
              = lucide_icon "check", size: 20
          - else
            = button_to complete_shopping_list_shopping_item_path(@list, item), method: :patch,
                class: "mw-shopping-item__btn",
                "aria-label": "Als erledigt markieren" do
              %span.mw-shopping-item__circle
        .mw-shopping-item__body
          .mw-shopping-item__name{ class: item.done? ? "mw-shopping-item__name--done" : nil }= item.name
          - if item.quantity.present?
            .mw-shopping-item__qty= item.quantity
          - if item.note.present?
            .mw-shopping-item__note= item.note
          - if item.done? && item.completed_by.present?
            .mw-shopping-item__meta
              = lucide_icon "check-circle-2", size: 12
              Erledigt von
              = item.completed_by.full_name.presence || item.completed_by.email
              um #{l(item.completed_at, format: :short)}
  - else
    %p.mw-text-muted{ style: "padding: 1rem 0;" }
      - if @open_only
        Alle Einträge sind erledigt.
      - else
        Noch keine Einträge.
