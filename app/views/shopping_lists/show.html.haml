- content_for :title, "#{@list.title} · Einkaufsliste · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @list.title
    %p.mw-page-header__lede
      - if @list.group
        = @list.group.name
        ·
      = l(@list.event_date, format: :long)
      ·
      %strong= @list.calendar_week_label
  .mw-page-header__actions
    - if current_user.staff?
      = render "shopping_lists/photo_import_button",
               url:     shopping_list_photo_imports_path(@list),
               label:   "Items aus Foto hinzufügen",
               icon:    "camera",
               variant: "secondary"
      = link_to edit_shopping_list_path(@list), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
    = link_to "Zurück", shopping_lists_path, class: "mw-page-action"

- if notice
  .mw-flash.mw-flash--success= notice
- if alert
  .mw-flash.mw-flash--error= alert

.mw-shopping-show
  .mw-shopping-show__bar
    #shopping_items_summary
      = render "shopping_items/summary", list: @list
    - if @open_only
      = link_to shopping_list_path(@list), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "list", size: 14
        Alle anzeigen
    - else
      = link_to shopping_list_path(@list, filter: "open"), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "filter", size: 14
        Nur offene

  - if @items.any?
    #shopping_items
      - group_shopping_items_by_category(@items).each do |category_key, items|
        - section_class = "mw-shopping-category"
        - section_class += " mw-shopping-category--pending" if category_key == "auto"
        %section{ class: section_class }
          %header.mw-shopping-category__header{ style: "display: flex; align-items: center; gap: 8px; margin-top: 1rem; margin-bottom: 0.25rem; color: var(--fg-2);" }
            = lucide_icon shopping_item_category_icon(category_key), size: 16
            %strong= shopping_item_category_label(category_key)
            %span.mw-text-muted{ style: "font-weight: normal;" }= "(#{items.size})"
          %ul.mw-shopping-list
            - items.each do |item|
              = render "shopping_items/show_item", item: item, list: @list
  - else
    .mw-empty-state
      %p.mw-text-muted
        - if @open_only
          Alle Einträge sind erledigt.
        - else
          Noch keine Einträge.
