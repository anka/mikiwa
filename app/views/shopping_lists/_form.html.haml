= form_with model: list, url: list.new_record? ? shopping_lists_path : shopping_list_path(list), class: "mw-form", html: { id: "shopping_list_form" } do |f|
  = f.hidden_field :kindergarten_year_id
  - if list.errors.any?
    .mw-flash.mw-flash--error
      %ul
        - list.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: list.new_record?, class: "mw-input"

  .mw-field-row
    .mw-field
      = f.label :event_date, "Einkaufstag", class: "mw-field__label"
      = f.date_field :event_date, required: true, class: "mw-input"
    .mw-field
      = f.label :group_id, "Gruppe (optional)", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, list.group_id),
          { include_blank: "— Gesamter Kindergarten —" }, class: "mw-select"
      %p.mw-field__hint Ohne Gruppe ist die Liste nur für Betreuer:innen sichtbar.

  .mw-field
    = f.label :assigned_to_id, "Verantwortlicher Elternteil (optional)", class: "mw-field__label"
    = f.select :assigned_to_id,
        options_from_collection_for_select(eligible_parents, :id, ->(u) { u.full_name.presence || u.email }, list.assigned_to_id),
        { include_blank: "— Nicht zugewiesen —" }, class: "mw-select"
    %p.mw-field__hint
      - if list.group_id.present?
        Auswahl beschränkt auf Eltern dieser Gruppe.
      - else
        Bei Gruppen-Auswahl wird die Liste nach Speichern entsprechend gefiltert.

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 2, class: "mw-input"

