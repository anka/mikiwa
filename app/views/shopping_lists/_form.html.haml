= form_with model: list, url: list.new_record? ? shopping_lists_path : shopping_list_path(list), class: "mw-form" do |f|
  - if list.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - list.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field-row
    .mw-field
      = f.label :event_date, "Bezugstag", class: "mw-field__label"
      = f.date_field :event_date, required: true, class: "mw-input"
    .mw-field
      = f.label :group_id, "Gruppe", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, list.group_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 2, class: "mw-input"

  .mw-field
    %label.mw-field__label Einträge
    = f.fields_for :shopping_items do |item_f|
      .mw-shopping-form-row
        = item_f.text_field :name, class: "mw-input mw-input--sm", placeholder: "Bezeichnung"
        = item_f.text_field :quantity, class: "mw-input mw-input--sm", placeholder: "Menge (optional)"
        = item_f.text_field :note, class: "mw-input mw-input--sm", placeholder: "Bemerkung (optional)"
        = item_f.check_box :_destroy, class: "mw-checkbox", id: "destroy_#{item_f.object.id}"
        = item_f.label :_destroy, "Entfernen", class: "mw-field__label mw-field__label--inline"

  .mw-form__actions
    = f.submit list.new_record? ? "Liste anlegen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", shopping_lists_path, class: "mw-btn mw-btn--ghost"
