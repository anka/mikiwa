= form_with model: kindergartenjahr,
    url: kindergartenjahr.new_record? ? kindergartenjahre_index_path : kindergartenjahre_path(kindergartenjahr),
    class: "mw-form" do |form|
  - if kindergartenjahr.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - kindergartenjahr.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = form.label :bezeichnung, "Bezeichnung", class: "mw-field__label"
    = form.text_field :bezeichnung, required: true, autofocus: true, class: "mw-input", placeholder: "z.B. KGJ 2026/27"

  .mw-field-row
    .mw-field
      = form.label :start_datum, "Startdatum", class: "mw-field__label"
      = form.date_field :start_datum, required: true, class: "mw-input"

    .mw-field
      = form.label :end_datum, "Enddatum", class: "mw-field__label"
      = form.date_field :end_datum, required: true, class: "mw-input"

  .mw-form__actions
    = form.submit kindergartenjahr.new_record? ? "Jahr anlegen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", kindergartenjahre_index_path, class: "mw-btn mw-btn--ghost"
