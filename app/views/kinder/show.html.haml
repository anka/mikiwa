- content_for :title, "#{@kind.vollstaendiger_name} · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @kind.vollstaendiger_name
    %p.mw-page-header__lede
      = @kind.gruppe.name
      ·
      = I18n.l(@kind.geburtsdatum, format: :short)
  = link_to "Bearbeiten", edit_kinder_path(@kind), class: "mw-btn mw-btn--secondary mw-btn--sm"

- if notice
  .mw-flash.mw-flash--success= notice

/ Versicherungsdaten
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Versicherung
    - if current_user.staff? || current_user.kinder.exists?(@kind.id)
      = link_to "Bearbeiten", edit_kinder_path(@kind), class: "mw-btn mw-btn--ghost mw-btn--sm"
  .mw-card{ style: "padding: 16px 20px;" }
    - if @kind.krankenkasse.present? || @kind.versicherungsnummer.present?
      .mw-text-strong{ style: "margin-bottom: 4px;" }= @kind.krankenkasse.presence || "–"
      %span.mw-text-muted Krankenkasse
      - if @kind.versicherungsnummer.present?
        %br
        .mw-text-strong{ style: "margin-top: 8px; margin-bottom: 4px;" }= @kind.versicherungsnummer
        %span.mw-text-muted Versicherungsnummer
    - else
      %p.mw-text-muted{ style: "margin: 0;" } Keine Versicherungsdaten hinterlegt.

/ Notfallkontakte
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Notfallkontakte
    = link_to "Hinzufügen", new_kinder_notfallkontakt_path(@kind), class: "mw-btn mw-btn--primary mw-btn--sm"
  .mw-card
    - if @kind.notfallkontakte.any?
      - @kind.notfallkontakte.each do |nk|
        .mw-nk-item
          .mw-nk-item__icon= nk.position
          .mw-nk-item__body
            .mw-nk-item__name= nk.name
            .mw-nk-item__meta
              = nk.beziehung
              ·
              = nk.telefon
          .mw-actions
            = link_to "Bearbeiten", edit_kinder_notfallkontakt_path(@kind, nk), class: "mw-btn mw-btn--secondary mw-btn--sm"
            = button_to "Löschen", kinder_notfallkontakt_path(@kind, nk), method: :delete,
                class: "mw-btn mw-btn--secondary mw-btn--sm",
                data: { turbo_confirm: "Notfallkontakt wirklich löschen?" }
    - else
      .mw-empty-state
        %p.mw-text-muted Noch keine Notfallkontakte hinterlegt.

/ Medizinische Hinweise
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Medizinische Hinweise
    = link_to "Hinzufügen", new_kinder_medizinischer_hinweis_path(@kind), class: "mw-btn mw-btn--primary mw-btn--sm"
  .mw-card
    - if @kind.medizinische_hinweise.any?
      - @kind.medizinische_hinweise.each do |mh|
        .mw-mh-item
          %span.mw-badge{ class: "mw-badge--#{badge_tone_for(mh.hinweis_typ)}" }= hinweis_typ_label(mh.hinweis_typ)
          .mw-mh-item__body
            .mw-mh-item__inhalt= mh.inhalt
          .mw-actions
            = link_to "Bearbeiten", edit_kinder_medizinischer_hinweis_path(@kind, mh), class: "mw-btn mw-btn--secondary mw-btn--sm"
            = button_to "Löschen", kinder_medizinischer_hinweis_path(@kind, mh), method: :delete,
                class: "mw-btn mw-btn--secondary mw-btn--sm",
                data: { turbo_confirm: "Hinweis wirklich löschen?" }
    - else
      .mw-empty-state
        %p.mw-text-muted Noch keine medizinischen Hinweise hinterlegt.

= link_to "Zurück zur Übersicht", kinder_index_path, class: "mw-btn mw-btn--ghost mw-btn--sm", style: "margin-top: 1.5rem; display: inline-block;"
