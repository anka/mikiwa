- content_for :title, "#{@kindergarten_year.label} bearbeiten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= "#{@kindergarten_year.label} bearbeiten"
  .mw-page-header__actions
    = link_to "Abbrechen", kindergarten_years_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "kindergarten_year_form" }
      = lucide_icon "check", size: 14
      Speichern

.mw-card{ style: "margin-top: 1.5rem; max-width: 560px;" }
  = render "form", kindergarten_year: @kindergarten_year
