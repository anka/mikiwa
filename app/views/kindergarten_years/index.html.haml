- content_for :title, "Kindergartenjahre · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Kindergartenjahre
    %p.mw-page-header__lede Verwalten Sie Planung und Jahresübergang.
  .mw-page-header__actions
    = link_to new_kindergarten_year_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
      = lucide_icon "plus", size: 16
      Neues Jahr anlegen

- if notice
  .mw-flash.mw-flash--success= notice

.mw-card{ style: "margin-top: 1.5rem;" }
  %table.mw-table{ style: "width: 100%;" }
    %thead
      %tr
        %th Bezeichnung
        %th Zeitraum
        %th Status
        %th{ style: "text-align: right;" } Aktionen
    %tbody
      - @kindergarten_years.each do |year|
        %tr
          %td
            %strong= year.label
          %td= "#{I18n.l(year.start_date, format: :short)} – #{I18n.l(year.end_date, format: :short)}"
          %td
            - case year.status
            - when "active"
              %span.mw-badge.mw-badge--success Aktiv
            - when "planning"
              %span.mw-badge.mw-badge--warning In Planung
            - when "archived"
              %span.mw-badge.mw-badge--neutral Archiviert
          %td{ style: "text-align: right;" }
            .mw-actions
              - unless year.active?
                = button_to activate_kindergarten_year_path(year), method: :patch,
                    class: "mw-page-action", title: "Aktivieren", "aria-label": "Aktivieren" do
                  = lucide_icon "check", size: 14
                = link_to rollover_kindergarten_year_path(year),
                    class: "mw-page-action", title: "Jahresübergang", "aria-label": "Jahresübergang" do
                  = lucide_icon "arrow-right", size: 14
              = link_to edit_kindergarten_year_path(year),
                  class: "mw-page-action", title: "Bearbeiten", "aria-label": "Bearbeiten" do
                = lucide_icon "pencil", size: 14
