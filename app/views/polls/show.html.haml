- content_for :title, "#{@poll.title} · Abstimmung · Mikiwa"

- total_voters = @results.values.flatten.uniq.size
- max_option_voters = @results.values.map(&:size).max || 0
- has_any_votes = total_voters.positive?

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @poll.title
    %p.mw-page-header__lede
      = @poll.group.name
      ·
      - if @poll.poll_type == "multiple"
        Mehrfachauswahl
      - else
        Einfachauswahl
      - if @poll.deadline.present?
        ·
        - if @poll.open?
          Stimmschluss: #{l(@poll.deadline, format: :long)}
        - else
          %span.mw-text-danger Stimmschluss überschritten (#{l(@poll.deadline, format: :long)})
  .mw-page-header__actions
    - if current_user.staff? && @poll.open?
      = button_to close_poll_path(@poll), method: :patch,
          class: "mw-page-action mw-page-action--danger",
          data: { turbo_confirm: "Abstimmung schließen?" } do
        = lucide_icon "x", size: 14
        Schließen
    - if current_user.staff?
      = link_to export_poll_path(@poll, format: :csv), class: "mw-page-action" do
        = lucide_icon "download", size: 14
        CSV-Export
    = link_to whatsapp_share_url(@poll.title, poll_url(@poll)),
        target: "_blank", rel: "noopener", class: "mw-page-action" do
      = lucide_icon "share-2", size: 14
      Teilen
    - if current_user.staff?
      = link_to edit_poll_path(@poll), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
    = link_to "Zurück", polls_path, class: "mw-page-action"

- if notice
  .mw-flash.mw-flash--success= notice
- if alert
  .mw-flash.mw-flash--error= alert

- if @poll.description.present?
  .mw-card{ style: "margin-top: 1rem; padding: 1rem 1.25rem;" }
    %p.mw-prose= @poll.description

- if current_user.parent?
  - if @poll.open?
    .mw-card.mw-poll-section{ style: "padding: 0;" }
      .mw-poll-section__header
        %h2.mw-poll-section__title Ihre Stimme
        %span.mw-poll-section__hint.mw-poll-section__hint--inline
          - if @poll.poll_type == "multiple"
            = lucide_icon "list-checks", size: 14
            Mehrfachauswahl möglich
          - else
            = lucide_icon "circle-dot", size: 14
            Eine Auswahl
      - if @user_options.any?
        .mw-poll-voted-note
          = lucide_icon "check-circle-2", size: 14
          Ihre Stimme wurde gespeichert. Sie können Ihre Auswahl jederzeit anpassen.
      = form_with url: vote_poll_path(@poll), method: :post do |f|
        .mw-poll-choice
          - @poll.poll_options.each do |opt|
            - checked = @user_options.include?(opt.id)
            %label.mw-poll-choice__option{ for: "opt_#{opt.id}" }
              - if @poll.poll_type == "multiple"
                = check_box_tag "option_ids[]", opt.id, checked,
                    id: "opt_#{opt.id}", class: "mw-poll-choice__input"
              - else
                = radio_button_tag "option_ids[]", opt.id, checked,
                    id: "opt_#{opt.id}", class: "mw-poll-choice__input"
              %span.mw-poll-choice__label= opt.label
              %span.mw-poll-choice__check
                = lucide_icon "check", size: 18
        .mw-poll-choice__actions
          = f.submit (@user_options.any? ? "Stimme aktualisieren" : "Stimme abgeben"),
              class: "mw-btn mw-btn--primary"
  - else
    .mw-flash.mw-flash--warning{ style: "margin-top: 1rem;" }
      Abstimmung ist geschlossen. Keine neuen Stimmen möglich.

.mw-card.mw-poll-section{ style: "padding: 0;" }
  .mw-poll-section__header
    %h2.mw-poll-section__title Ergebnis
    %span.mw-poll-section__hint
      = total_voters
      = total_voters == 1 ? "Teilnehmer:in" : "Teilnehmer:innen"
  - if has_any_votes
    .mw-poll-results
      - @results.each do |option, voters|
        - count        = voters.size
        - pct          = total_voters.positive? ? (count.to_f / total_voters * 100).round : 0
        - is_leading   = count.positive? && count == max_option_voters
        - is_mine      = current_user.parent? && @user_options.include?(option.id)
        - modifiers    = []
        - modifiers << "mw-poll-result--leading" if is_leading
        - modifiers << "mw-poll-result--mine"    if is_mine
        .mw-poll-result{ class: modifiers.join(" ") }
          .mw-poll-result__header
            .mw-poll-result__label
              - if is_mine
                %span.mw-poll-result__mine-dot{ "aria-hidden": "true" }
              = option.label
            .mw-poll-result__stats
              %span.mw-poll-result__percent= "#{pct} %"
              %span.mw-poll-result__count
                = "(#{count} Stimme#{count == 1 ? '' : 'n'})"
          .mw-poll-result__bar-track{ role: "progressbar",
                                      "aria-valuenow": pct,
                                      "aria-valuemin": 0,
                                      "aria-valuemax": 100,
                                      "aria-label": option.label }
            .mw-poll-result__bar-fill{ data: { controller: "poll-bar",
                                               "poll-bar-pct-value": pct } }
          - if current_user.staff? && voters.any?
            .mw-poll-result__voters
              = voters.map { |u| u.full_name.presence || u.email }.join(", ")
  - else
    .mw-poll-results__empty Noch keine Stimmen abgegeben.
