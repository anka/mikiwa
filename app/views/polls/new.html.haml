- content_for :title, "Neue Abstimmung · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Neue Abstimmung
  .mw-page-header__actions
    = link_to "Abbrechen", polls_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "poll_form" }
      = lucide_icon "check", size: 14
      Speichern

= render "form", poll: @poll, groups: @groups,
    kindergarten_years: @kindergarten_years, events: @events
