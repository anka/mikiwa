= form_with model: poll, url: poll.new_record? ? polls_path : poll_path(poll), class: "mw-form", html: { id: "poll_form" } do |f|
  - if poll.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - poll.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = f.label :title, "Titel", class: "mw-field__label"
    = f.text_field :title, required: true, autofocus: true, class: "mw-input"

  .mw-field-row
    .mw-field
      = f.label :poll_type, "Typ", class: "mw-field__label"
      = f.select :poll_type,
          [["Einfachauswahl", "single"], ["Mehrfachauswahl", "multiple"]],
          {}, class: "mw-select"
    .mw-field
      = f.label :group_id, "Gruppe", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, poll.group_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true

  .mw-field-row
    .mw-field
      = f.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
      = f.select :kindergarten_year_id,
          options_from_collection_for_select(kindergarten_years, :id, :label, poll.kindergarten_year_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true
    .mw-field
      = f.label :deadline, "Stimmschluss (optional)", class: "mw-field__label"
      = f.datetime_local_field :deadline, class: "mw-input"

  .mw-field
    = f.label :description, "Beschreibung (optional)", class: "mw-field__label"
    = f.text_area :description, rows: 3, class: "mw-input"

  - if events.any?
    .mw-field
      = f.label :event_id, "Verknüpfte Veranstaltung (optional)", class: "mw-field__label"
      = f.select :event_id,
          options_from_collection_for_select(events, :id, :title, poll.event_id),
          { include_blank: "Keine" }, class: "mw-select"

  .mw-field{ "data-controller": "poll-options" }
    %label.mw-field__label Optionen
    .mw-poll-options-list{ "data-poll-options-target": "list" }
      = f.fields_for :poll_options do |opt_f|
        .mw-poll-option-row{ "data-poll-options-row": "" }
          - if opt_f.object.persisted?
            = opt_f.hidden_field :id, "data-persisted": true
            = opt_f.hidden_field :_destroy, value: "0", "data-destroy": true
          = opt_f.hidden_field :position, "data-position": true
          = opt_f.text_field :label, class: "mw-input mw-input--sm", placeholder: "Bezeichnung", required: true
          %button.mw-poll-option-row__remove{ type: "button", "data-action": "poll-options#remove" }
            = lucide_icon "x", size: 14
    %button.mw-btn.mw-btn--secondary.mw-btn--sm{ type: "button", "data-action": "poll-options#add", style: "margin-top: 0.5rem;" }
      = lucide_icon "plus", size: 14
      Option hinzufügen

  / Template für neue Optionen (wird nicht abgeschickt)
  %template{ "data-poll-options-target": "template" }
    .mw-poll-option-row{ "data-poll-options-row": "" }
      %input{ type: "hidden", name: "poll[poll_options_attributes][NEW_RECORD_INDEX][position]", "data-position": true, value: "0" }
      %input{ type: "text", name: "poll[poll_options_attributes][NEW_RECORD_INDEX][label]", class: "mw-input mw-input--sm", placeholder: "Bezeichnung", required: true }
      %button.mw-poll-option-row__remove{ type: "button", "data-action": "poll-options#remove" }
        #{lucide_icon "x", size: 14}
