- content_for :title, "Posteingang · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Posteingang
    - unread = @entries.count { |e| !e.read? }
    - if unread > 0
      %p.mw-page-header__lede= "#{unread} ungelesen"

- if @entries.any?
  .mw-card{ style: "margin-top: 1.5rem;" }
    %table.mw-table.mw-table--cards{ style: "width: 100%;" }
      %thead
        %tr
          %th Betreff
          %th Gruppen
          %th Datum
          %th Status
      %tbody
        - @entries.each do |entry|
          %tr{ class: entry.read? ? nil : "mw-table-row--unread" }
            %td{ "data-label": "Betreff" }
              = link_to entry.message.title, inbox_message_path(entry.message), class: "mw-link"
            %td{ "data-label": "Gruppen" }= entry.message.groups.map(&:name).join(", ")
            %td{ "data-label": "Datum" }= l(entry.created_at, format: :short)
            %td{ "data-label": "Status" }
              - if entry.read?
                %span.mw-badge.mw-badge--neutral Gelesen
              - else
                %span.mw-badge.mw-badge--accent Neu
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Ihr Posteingang ist leer.
