= form_with model: [@kind, medizinischer_hinweis],
    url: medizinischer_hinweis.new_record? ? kinder_medizinische_hinweise_path(@kind) : kinder_medizinischer_hinweis_path(@kind, medizinischer_hinweis),
    method: medizinischer_hinweis.new_record? ? :post : :patch,
    class: "mw-form" do |form|
  - if medizinischer_hinweis.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - medizinischer_hinweis.errors.full_messages.each do |msg|
          %li= msg

  .mw-field
    = form.label :hinweis_typ, "Art des Hinweises", class: "mw-field__label"
    = form.select :hinweis_typ,
        [["Allergie", "allergie"], ["Medikament", "medikament"], ["Besonderheit", "besonderheit"]],
        { prompt: "Bitte wählen …" },
        required: true, class: "mw-input"

  .mw-field
    = form.label :inhalt, "Beschreibung", class: "mw-field__label"
    = form.text_area :inhalt, required: true, rows: 3, class: "mw-input", style: "resize: vertical;"
    %p.mw-field__hint Diese Information wird verschlüsselt gespeichert.

  .mw-form__actions
    = form.submit medizinischer_hinweis.new_record? ? "Hinweis hinzufügen" : "Änderungen speichern", class: "mw-btn mw-btn--primary"
    = link_to "Abbrechen", kinder_path(@kind), class: "mw-btn mw-btn--ghost"
