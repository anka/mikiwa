- content_for :title, "Mein Profil · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Mein Profil
  .mw-page-header__actions
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "profile_form" }
      = lucide_icon "check", size: 14
      Speichern

- if notice
  .mw-flash.mw-flash--success= notice

.mw-card{ style: "margin-top: 1.5rem; max-width: 480px;" }
  = form_with model: current_user, url: profile_path, method: :patch, class: "mw-form", html: { id: "profile_form" } do |form|
    - if current_user.errors.any?
      .mw-flash.mw-flash--error
        %ul{ style: "margin: 0; padding-left: 1.25rem;" }
          - current_user.errors.full_messages.each do |msg|
            %li= msg

    .mw-field
      = form.label :first_name, "Vorname", class: "mw-field__label"
      = form.text_field :first_name, class: "mw-input"

    .mw-field
      = form.label :last_name, "Nachname", class: "mw-field__label"
      = form.text_field :last_name, class: "mw-input"

    .mw-field
      = form.label :email, "E-Mail-Adresse", class: "mw-field__label"
      = form.email_field :email, class: "mw-input"

    .mw-field
      = form.label :phone, "Telefonnummer", class: "mw-field__label"
      = form.telephone_field :phone, class: "mw-input", placeholder: "0664 123 456"


.mw-card{ style: "margin-top: 1.5rem; max-width: 480px;" }
  %h2.mw-section-title{ style: "padding: 1rem 1.25rem 0; font-size: var(--fs-14); font-weight: var(--fw-bold); color: var(--fg-2);" } Kalender-Abonnement
  .mw-detail-list
    .mw-detail-row
      .mw-detail-row__icon= lucide_icon "link", size: 18
      .mw-detail-row__content
        .mw-detail-row__label Persönlicher iCal-Feed
        .mw-detail-row__value
          - ical_url = "#{request.base_url}/calendar/#{current_user.ical_token}.ics"
          %code.mw-mono{ style: "font-size: 12px; word-break: break-all; color: var(--fg-2);" }= ical_url
          %p.mw-field__hint{ style: "margin-top: 0.5rem;" }
            Abonnieren Sie diesen Link in Apple Kalender, Google Kalender oder Outlook, um Ihre Ereignisse zu synchronisieren.
          = button_to rotate_ical_token_profile_path, method: :patch,
              class: "mw-btn mw-btn--ghost mw-btn--sm", style: "margin-top: 0.5rem;",
              data: { turbo_confirm: "Token zurücksetzen? Der alte Link wird danach ungültig." } do
            = lucide_icon "x", size: 14
            Token zurücksetzen
