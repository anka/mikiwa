- content_for :title, "Mein Profil · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Mein Profil
  .mw-page-header__actions
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "profile_form" }
      = lucide_icon "check", size: 14
      Speichern

- if notice
  .mw-flash.mw-flash--success= notice

.mw-card{ style: "margin-top: 1.5rem; max-width: 480px;" }
  = form_with model: current_user, url: profile_path, method: :patch, class: "mw-form", html: { id: "profile_form" } do |form|
    - if current_user.errors.any?
      .mw-flash.mw-flash--error
        %ul{ style: "margin: 0; padding-left: 1.25rem;" }
          - current_user.errors.full_messages.each do |msg|
            %li= msg

    .mw-field
      = form.label :first_name, class: "mw-field__label" do
        | Vorname
        - if current_user.parent?
          %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
      = form.text_field :first_name, required: current_user.parent?, class: "mw-input"

    .mw-field
      = form.label :last_name, class: "mw-field__label" do
        | Nachname
        - if current_user.parent?
          %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
      = form.text_field :last_name, required: current_user.parent?, class: "mw-input"

    .mw-field
      = form.label :email, "E-Mail-Adresse", class: "mw-field__label"
      = form.email_field :email, class: "mw-input"

    .mw-field
      = form.label :phone, class: "mw-field__label" do
        | Telefonnummer
        - if current_user.parent?
          %span.mw-field__required{ aria: { label: "Pflichtfeld" } } *
      = form.telephone_field :phone, required: current_user.parent?, class: "mw-input", placeholder: "0664 123 456"

    .mw-field
      = form.label :knowhow, "Wissen / Fähigkeiten", class: "mw-field__label"
      = form.text_area :knowhow, class: "mw-input", rows: 3,
          placeholder: "z. B. Tischler, kann Bastel-AGs unterstützen"
      %p.mw-field__hint Optional, hilft Betreuer:innen bei der Planung gemeinsamer Aktivitäten.

    - unless current_user.parent?
      .mw-field
        = form.label :notes, "Anmerkung", class: "mw-field__label"
        = form.text_area :notes, class: "mw-input", rows: 3,
            placeholder: "Persönliche Notizen"


.mw-card{ style: "margin-top: 1.5rem; max-width: 480px;" }
  %h2.mw-section-title{ style: "padding: 1rem 1.25rem 0; font-size: var(--fs-14); font-weight: var(--fw-bold); color: var(--fg-2);" } Kalender-Abonnement
  %p.mw-card__lede{ style: "padding: 0 1.25rem; margin: 0.25rem 0 0.5rem; color: var(--fg-2); font-size: var(--fs-14);" }
    Abonnieren Sie alle für Sie relevanten Termine direkt in Ihrer gewohnten Kalender-App
    (z.&nbsp;B. Apple Kalender, Google Kalender oder Outlook).
    Der Feed enthält Veranstaltungen, Kalendereinträge sowie Geburtstage Ihrer Kinder und
    aktualisiert sich automatisch – Sie müssen nichts manuell pflegen.
  .mw-detail-list
    .mw-detail-row
      .mw-detail-row__icon= lucide_icon "link", size: 18
      .mw-detail-row__content
        .mw-detail-row__label Persönlicher iCal-Feed
        .mw-detail-row__value{ data: { controller: "clipboard", "clipboard-text-value": "#{request.base_url}/calendar/#{current_user.ical_token}.ics" } }
          -# F77: Primärer Button öffnet die Kalender-App via webcal://
          - webcal_url = "webcal://#{request.host_with_port}/calendar/#{current_user.ical_token}.ics"
          = link_to webcal_url, class: "mw-btn mw-btn--primary mw-btn--sm", target: "_self" do
            = lucide_icon "calendar-plus", size: 14
            In Kalender-App öffnen
          .mw-ical-fallback{ style: "margin-top: 0.75rem;" }
            %code.mw-mono{ style: "font-size: 12px; word-break: break-all; color: var(--fg-2); display: block;" }
              = "#{request.base_url}/calendar/#{current_user.ical_token}.ics"
            %button.mw-btn.mw-btn--ghost.mw-btn--sm{ type: "button",
                style: "margin-top: 0.5rem;",
                data: { action: "click->clipboard#copy", clipboard_target: "trigger" } }
              = lucide_icon "copy", size: 14
              %span{ data: { clipboard_target: "label" } } Kopieren
          %p.mw-field__hint{ style: "margin-top: 0.5rem;" }
            Klicken Sie den Link, um Ihre Kalender-App zu öffnen, oder kopieren Sie die URL für Google Kalender bzw. Outlook.
          = button_to rotate_ical_token_profile_path, method: :patch,
              class: "mw-btn mw-btn--ghost mw-btn--sm", style: "margin-top: 0.5rem;",
              data: { turbo_confirm: "Token zurücksetzen? Der alte Link wird danach ungültig." } do
            = lucide_icon "x", size: 14
            Token zurücksetzen
