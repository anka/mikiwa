-# Inline-Form zum Hinzufügen eines neuen Eintrags. Wird nach erfolgreichem
-# Submit per Turbo-Stream durch eine frische Instanz ersetzt.
- focus_on_connect = local_assigns.fetch(:focus_on_connect, false)
- form_data = { controller: "shopping-new-item" }
- form_data["focus-on-connect"] = "true" if focus_on_connect
= form_with model: item,
            url: shopping_list_shopping_items_path(list),
            method: :post,
            multipart: true,
            html: { id:    "new_shopping_item",
                    class: "mw-shopping-new mw-shopping-editor__new-item",
                    data: form_data } do |f|
  - if item.errors.any?
    .mw-shopping-new__errors
      = item.errors.full_messages.to_sentence

  .mw-shopping-new__row.mw-shopping-new__row--primary
    = f.text_field :name,
                   placeholder: "Was wird gebraucht?",
                   required: true,
                   autocomplete: "off",
                   autofocus: focus_on_connect,
                   class: "mw-input mw-shopping-new__name",
                   data: { "shopping-new-item-target": "name" }
    %button.mw-btn.mw-btn--primary.mw-btn--sm.mw-shopping-new__submit{ type: "submit" }
      = lucide_icon "plus", size: 16
      %span.mw-shopping-new__submit-label Hinzufügen
    -# F82: 'Mehr Details' Toggle – auf Mobile sichtbar, auf Desktop via CSS versteckt
    %button.mw-shopping-new__more{ type: "button",
                                    "aria-expanded": "false",
                                    "aria-label": "Mehr Details",
                                    data: { "shopping-new-item-target": "toggle",
                                            action: "click->shopping-new-item#toggleDetails" } }
      = lucide_icon "chevron-down", size: 16

  -# F82: Details-Block. Auf Mobile zugeklappt (hidden), auf Desktop via CSS immer offen.
  .mw-shopping-new__details{ data: { "shopping-new-item-target": "details" }, hidden: true }
    .mw-shopping-new__row.mw-shopping-new__row--secondary
      = f.text_field :quantity,
                     placeholder: "Menge",
                     autocomplete: "off",
                     class: "mw-input mw-shopping-new__qty"
      = f.text_field :note,
                     placeholder: "Notiz (optional)",
                     autocomplete: "off",
                     class: "mw-input mw-shopping-new__note"

    .mw-shopping-new__row.mw-shopping-new__row--secondary
      -# F79: 'Automatisch' ist Default für Neuanlage; OpenAI klassifiziert im Job.
      - auto_label      = t("activerecord.attributes.shopping_item.categories.auto")
      - auto_option     = [ [ auto_label, "auto" ] ]
      - regular_options = ShoppingItem::CATEGORY_ORDER.map { |k| [ shopping_item_category_label(k), k ] }
      = f.select :category,
                 options_for_select(auto_option + regular_options, (item.category.presence || "auto")),
                 { include_blank: "— keine Kategorie —" },
                 class: "mw-select mw-shopping-new__category"

      %label.mw-shopping-new__photo{ title: "Bild anhängen" }
        = lucide_icon "image-plus", size: 18
        %span.mw-shopping-new__photo-label Bild
        = f.file_field :photo,
                        accept: "image/*",
                        class: "mw-shopping-new__photo-input",
                        data: { "shopping-new-item-target": "photo",
                                action: "change->shopping-new-item#previewPhoto" }

  %div.mw-shopping-new__photo-preview{ data: { "shopping-new-item-target": "preview" }, hidden: true }
    %img{ data: { "shopping-new-item-target": "previewImg" }, alt: "" }
    %button.mw-shopping-new__photo-remove{ type: "button",
                                            data: { action: "shopping-new-item#clearPhoto" } }
      = lucide_icon "x", size: 14
