-# Anzeige-Variante eines Items für die Eltern-/Vorschau-Liste.
-# Tap auf den Check-Button toggelt den Status per Turbo Stream.
%li.mw-shopping-item{ id: dom_id(item), class: item.done? ? "mw-shopping-item--done" : nil }
  .mw-shopping-item__check
    - if item.done?
      = button_to uncomplete_shopping_list_shopping_item_path(list, item),
                    method: :patch,
                    class: "mw-shopping-item__btn mw-shopping-item__btn--done",
                    "aria-label": "Als offen markieren" do
        = lucide_icon "check", size: 20
    - else
      = button_to complete_shopping_list_shopping_item_path(list, item),
                    method: :patch,
                    class: "mw-shopping-item__btn",
                    "aria-label": "Als erledigt markieren" do
        %span.mw-shopping-item__circle

  - if item.photo.attached?
    .mw-shopping-item__thumb
      = image_tag item.photo.variant(:thumb), alt: item.name

  .mw-shopping-item__body
    .mw-shopping-item__title-row
      .mw-shopping-item__name{ class: item.done? ? "mw-shopping-item__name--done" : nil }= item.name
      - if item.quantity.present?
        .mw-shopping-item__qty= item.quantity
    - if item.note.present?
      .mw-shopping-item__note= item.note
    - if item.done? && item.completed_by.present?
      .mw-shopping-item__meta
        = lucide_icon "check-circle-2", size: 12
        Erledigt von #{item.completed_by.full_name.presence || item.completed_by.email} um #{l(item.completed_at, format: :short)}
