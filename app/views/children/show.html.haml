- content_for :title, "#{@child.full_name} · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @child.full_name
    %p.mw-page-header__lede
      = @child.group.name
      ·
      = I18n.l(@child.date_of_birth, format: :short)
  .mw-page-header__actions
    - if current_user.staff?
      = button_to deactivate_child_path(@child), method: :patch,
          class: "mw-page-action mw-page-action--danger",
          data: { turbo_confirm: "#{@child.full_name} wirklich deaktivieren?" } do
        = lucide_icon "x", size: 14
        Deaktivieren
      = link_to edit_child_path(@child), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
    = link_to "Zurück", children_path, class: "mw-page-action"

- if notice
  .mw-flash.mw-flash--success= notice

/ Eltern
= render "parents_section", child: @child

/ Versicherungsdaten
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Versicherung
    - if current_user.staff? || current_user.children.exists?(@child.id)
      = link_to edit_child_path(@child), class: "mw-page-action" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
  .mw-card{ style: "padding: 16px 20px;" }
    - if @child.health_insurer.present? || @child.insurance_number.present?
      .mw-text-strong{ style: "margin-bottom: 4px;" }= @child.health_insurer.presence || "–"
      %span.mw-text-muted Krankenkasse
      - if @child.insurance_number.present?
        %br
        .mw-text-strong{ style: "margin-top: 8px; margin-bottom: 4px;" }= @child.insurance_number
        %span.mw-text-muted Versicherungsnummer
    - else
      %p.mw-text-muted{ style: "margin: 0;" } Keine Versicherungsdaten hinterlegt.

/ Foto-Einwilligung
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Foto-Einwilligung
  .mw-card{ style: "padding: 16px 20px;" }
    .mw-detail-list-row
      .mw-detail-list-row__label Status
      .mw-detail-list-row__value
        - if @child.photo_consent
          %span.mw-badge.mw-badge--success Erteilt
        - else
          %span.mw-badge.mw-badge--danger Nicht erteilt
    - if @child.photo_consent_updated_at.present?
      .mw-detail-list-row
        .mw-detail-list-row__label Zuletzt geändert
        .mw-detail-list-row__value= l(@child.photo_consent_updated_at, format: :long)
    - if current_user.staff? || current_user.children.exists?(@child.id)
      .mw-form__actions{ style: "margin-top: 0.75rem;" }
        - if @child.photo_consent
          = button_to update_consent_child_path(@child), method: :patch,
              params: { child: { photo_consent: false } },
              class: "mw-btn mw-btn--secondary mw-btn--sm",
              data: { turbo_confirm: "Foto-Einwilligung widerrufen?" } do
            Einwilligung widerrufen
        - else
          = button_to update_consent_child_path(@child), method: :patch,
              params: { child: { photo_consent: true } },
              class: "mw-btn mw-btn--primary mw-btn--sm" do
            Einwilligung erteilen

/ Notfallkontakte
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Notfallkontakte
    = link_to new_child_emergency_contact_path(@child), class: "mw-page-action" do
      = lucide_icon "plus", size: 14
      Hinzufügen
  .mw-card
    - if @child.emergency_contacts.any?
      - @child.emergency_contacts.each do |ec|
        .mw-nk-item
          .mw-nk-item__icon= ec.position
          .mw-nk-item__body
            .mw-nk-item__name= ec.name
            .mw-nk-item__meta
              = ec.relationship
              ·
              = ec.phone
          .mw-actions
            = link_to edit_child_emergency_contact_path(@child, ec), class: "mw-page-action" do
              = lucide_icon "pencil", size: 14
              Bearbeiten
            = button_to child_emergency_contact_path(@child, ec), method: :delete,
                class: "mw-page-action mw-page-action--danger",
                data: { turbo_confirm: "Notfallkontakt wirklich löschen?" } do
              = lucide_icon "trash-2", size: 14
              Löschen
    - else
      .mw-empty-state
        %p.mw-text-muted Noch keine Notfallkontakte hinterlegt.

/ Medizinische Hinweise
.mw-detail-section
  .mw-detail-section__header
    %span.mw-detail-section__title Medizinische Hinweise
    = link_to new_child_medical_note_path(@child), class: "mw-page-action" do
      = lucide_icon "plus", size: 14
      Hinzufügen
  .mw-card
    - if @child.medical_notes.any?
      - @child.medical_notes.each do |mn|
        .mw-mh-item
          %span.mw-badge{ class: "mw-badge--#{badge_tone_for(mn.note_type)}" }= note_type_label(mn.note_type)
          .mw-mh-item__body
            .mw-mh-item__inhalt= mn.content
          .mw-actions
            = link_to edit_child_medical_note_path(@child, mn), class: "mw-page-action" do
              = lucide_icon "pencil", size: 14
              Bearbeiten
            = button_to child_medical_note_path(@child, mn), method: :delete,
                class: "mw-page-action mw-page-action--danger",
                data: { turbo_confirm: "Hinweis wirklich löschen?" } do
              = lucide_icon "trash-2", size: 14
              Löschen
    - else
      .mw-empty-state
        %p.mw-text-muted Noch keine medizinischen Hinweise hinterlegt.

