= form_with model: child, url: child.new_record? ? children_path : child_path(child), method: child.new_record? ? :post : :patch, class: "mw-form", html: { id: "child_form" } do |form|
  - if child.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - child.errors.full_messages.each do |msg|
          %li= msg

  .mw-field-row
    .mw-field
      = form.label :first_name, "Vorname", class: "mw-field__label"
      = form.text_field :first_name, required: true, autofocus: true, class: "mw-input"
    .mw-field
      = form.label :last_name, "Nachname", class: "mw-field__label"
      = form.text_field :last_name, required: true, class: "mw-input"

  .mw-field
    = form.label :nickname, "Rufname / Spitzname (optional)", class: "mw-field__label"
    = form.text_field :nickname, class: "mw-input"

  .mw-field
    = form.label :date_of_birth, "Geburtsdatum", class: "mw-field__label"
    = form.date_field :date_of_birth, required: true, class: "mw-input"

  .mw-field
    = form.label :group_id, "Gruppe", class: "mw-field__label"
    = form.collection_select :group_id, Group.order(:name), :id, :name, { prompt: "Gruppe wählen …" }, class: "mw-input", required: true

  .mw-field
    = form.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
    = form.collection_select :kindergarten_year_id, KindergartenYear.order(start_date: :desc), :id, :label, { prompt: "Jahr wählen …" }, class: "mw-input", required: true

  .mw-field
    %p.mw-field__label Foto-Einwilligung
    .mw-radio-group
      %label.mw-radio-option
        = form.radio_button :photo_consent, "1", required: true
        %span Ja – Fotos des Kindes dürfen in der Plattform verwendet werden
      %label.mw-radio-option
        = form.radio_button :photo_consent, "0", required: true
        %span Nein – keine Fotos

  .mw-field
    = form.label :parent_id, "Elternteil verknüpfen (optional)", class: "mw-field__label"
    = form.select :parent_id,
        User.where(role: "parent").order(:last_name, :first_name).map { |u| ["#{u.full_name} (#{u.email})", u.id] },
        { prompt: "Elternteil auswählen …" },
        class: "mw-input",
        name: "child[parent_id]"

  .mw-field-row
    .mw-field
      = form.label :health_insurer, "Krankenkasse (optional)", class: "mw-field__label"
      = form.text_field :health_insurer, class: "mw-input", placeholder: "z.B. ÖGK, BVA …"
    .mw-field
      = form.label :insurance_number, "Versicherungsnummer (optional)", class: "mw-field__label"
      = form.text_field :insurance_number, class: "mw-input"
      %p.mw-field__hint Wird verschlüsselt gespeichert.

  .mw-field
    = form.label :profile_photo, "Profilfoto (optional)", class: "mw-field__label"
    = form.file_field :profile_photo, accept: ImageAttachable::ALLOWED_TYPES.join(","), class: "mw-input"

