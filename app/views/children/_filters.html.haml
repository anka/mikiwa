- url ||= children_path
- active_count = [ @filter_q.presence, @filter_group_id.presence, @filter_age.presence ].compact.size
- clear_search_query = { group_id: @filter_group_id, age: @filter_age }.compact_blank
- clear_search_url = clear_search_query.any? ? "#{url}?#{clear_search_query.to_query}" : url

= form_with url: url, method: :get, local: true, class: "mw-filters" do
  .mw-filters__row
    .mw-filters__search
      = lucide_icon "search", size: 16, class: "mw-filters__search-icon"
      = text_field_tag :q, @filter_q,
          id: "filter-q",
          placeholder: "Name suchen …",
          autocomplete: "off",
          class: "mw-input mw-filters__search-input"
      - if @filter_q.present?
        = link_to clear_search_url,
            class: "mw-filters__clear",
            "aria-label": "Suchtext löschen",
            title: "Suchtext löschen" do
          = lucide_icon "x", size: 14

    = select_tag :group_id,
                 options_from_collection_for_select(@filter_groups, :id, :name, @filter_group_id),
                 include_blank: "Alle Gruppen",
                 id: "filter-group-id",
                 class: "mw-select mw-filters__select",
                 onchange: "this.form.requestSubmit()"

    = select_tag :age,
                 options_for_select(@filter_ages.map { |a| [ pluralize(a, "Jahr", "Jahre"), a ] }, @filter_age),
                 include_blank: "Alle Altersstufen",
                 id: "filter-age",
                 class: "mw-select mw-filters__select",
                 onchange: "this.form.requestSubmit()"

    .mw-filters__actions
      = submit_tag "Filtern", class: "mw-btn mw-btn--primary mw-btn--sm"
      - if active_count.positive?
        = link_to url, class: "mw-page-action mw-filters__reset" do
          = lucide_icon "rotate-ccw", size: 14
          Zurücksetzen
          %span.mw-badge.mw-badge--accent.mw-filters__reset-count= active_count
