- total = children.size
- ages = children.group_by(&:age).transform_values(&:size)
- groups = children.group_by(&:group).transform_values(&:size)

.mw-card.mw-children-facts
  .mw-children-facts__row
    %span.mw-children-facts__label Gesamt
    .mw-children-facts__pills
      %span.mw-badge.mw-badge--accent= pluralize(total, "Kind", "Kinder")

  - if ages.any?
    .mw-children-facts__row
      %span.mw-children-facts__label Alter
      .mw-children-facts__pills
        - ages.sort_by { |age, _| age.nil? ? -1 : age }.each do |age, count|
          %span.mw-badge.mw-badge--neutral
            - if age.nil?
              ohne Datum
              %span.mw-children-facts__count= count
            - else
              #{age} J.
              %span.mw-children-facts__count= count

  - if groups.any?
    .mw-children-facts__row
      %span.mw-children-facts__label Gruppe
      .mw-children-facts__pills
        - groups.sort_by { |group, _| group&.name || "–" }.each do |group, count|
          %span.mw-badge.mw-badge--neutral
            - if group&.color.present?
              %span.mw-children-facts__dot{ style: "background: #{group.color};" }
            = group&.name || "–"
            %span.mw-children-facts__count= count
