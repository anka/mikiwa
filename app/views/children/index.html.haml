- content_for :title, "Kinder · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Kinder
    %p.mw-page-header__lede Alle Kinder im aktiven Kindergartenjahr.
  - if current_user.staff?
    .mw-page-header__actions
      = link_to inactive_children_path, class: "mw-page-action" do
        = lucide_icon "eye-off", size: 14
        Deaktivierte Kinder
      = link_to children_path(format: :xlsx, q: @filter_q.presence, group_id: @filter_group_id.presence, age: @filter_age.presence), class: "mw-page-action" do
        = lucide_icon "download", size: 14
        Excel exportieren
      = link_to new_child_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Kind anlegen

- if notice
  .mw-flash.mw-flash--success= notice


- if @children.any?
  
  = render "facts", children: @children
  
  = render "filters"
  
  .mw-card{ style: "margin-top: 1.5rem;" }
    %table.mw-table.mw-table--cards{ style: "width: 100%;" }
      %thead
        %tr
          %th Name
          %th Geburtsdatum
          %th Alter
          %th Gruppe
          %th Foto-Einw.
          - if current_user.staff?
            %th{ style: "text-align: right;" } Aktionen
      %tbody
        - @children.each do |child|
          %tr
            %td{ "data-label": "Name" }
              .mw-child-name-cell
                - if child.profile_photo.attached?
                  = image_tag child.profile_photo.variant(**ImageAttachable::VARIANT_CONFIGS[:thumb]),
                      class: "mw-child-avatar mw-child-avatar--sm", alt: ""
                - else
                  .mw-child-avatar.mw-child-avatar--sm.mw-child-avatar--placeholder
                    = child.first_name[0].upcase
                .mw-child-name-cell__text
                  = link_to child_path(child), style: "text-decoration: none; color: inherit;" do
                    %strong= child.full_name
                  - if child.nickname.present?
                    %span.mw-text-muted{ style: "font-size: var(--fs-12); margin-left: 4px;" }= "(#{child.nickname})"
            %td{ "data-label": "Geburtsdatum" }= I18n.l(child.date_of_birth, format: :short)
            %td{ "data-label": "Alter" }= child_age_label(child)
            %td{ "data-label": "Gruppe" }
              - if child.group&.color.present?
                %span{ style: "display:inline-flex;align-items:center;gap:6px;" }
                  %span{ style: "width:10px;height:10px;border-radius:50%;background:#{child.group.color};flex-shrink:0;" }
                  = child.group.name
              - else
                = child.group&.name || "–"
            %td{ "data-label": "Foto-Einw." }
              - if child.photo_consent
                %span.mw-badge.mw-badge--success Ja
              - else
                %span.mw-badge.mw-badge--neutral Nein
            - if current_user.staff?
              %td{ "data-label": "Aktionen", style: "text-align: right;" }
                .mw-actions
                  = link_to edit_child_path(child), class: "mw-page-action", title: "Bearbeiten", "aria-label": "Bearbeiten" do
                    = lucide_icon "pencil", size: 14
                  = button_to deactivate_child_path(child), method: :patch,
                      class: "mw-page-action mw-page-action--danger",
                      title: "Deaktivieren", "aria-label": "Deaktivieren",
                      data: { turbo_confirm: "#{child.full_name} wirklich deaktivieren?" } do
                    = lucide_icon "x", size: 14
- else
  .mw-empty-state
    %p.mw-text-muted Noch keine Kinder im aktiven Kindergartenjahr.
    - if current_user.staff?
      = link_to "Erstes Kind anlegen", new_child_path, class: "mw-btn mw-btn--primary mw-btn--sm"
