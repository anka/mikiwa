- content_for :title, "Neue Veranstaltung · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Neue Veranstaltung
    %p.mw-page-header__lede Datum, Ort und betroffene Gruppen festlegen.
  .mw-page-header__actions
    = link_to "Abbrechen", events_path, class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "event_form" }
      = lucide_icon "check", size: 14
      Speichern

= render "form", event: @event, groups: @groups, kindergarten_years: @kindergarten_years
