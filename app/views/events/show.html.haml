- content_for :title, "#{@event.title} · Veranstaltungen · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title= @event.title
    - if @event.cancelled?
      %span.mw-badge.mw-badge--danger{ style: "margin-top: 0.25rem;" } Abgesagt
  .mw-page-header__actions
    - if current_user.staff? && !@event.cancelled?
      = button_to cancel_event_path(@event), method: :patch,
          class: "mw-page-action mw-page-action--danger",
          data: { turbo_confirm: "Veranstaltung wirklich absagen?" } do
        = lucide_icon "x", size: 14
        Absagen
    = link_to whatsapp_share_url(@event.title, event_url(@event)),
        target: "_blank", rel: "noopener", class: "mw-page-action" do
      = lucide_icon "share-2", size: 14
      Teilen
    - if current_user.staff?
      = link_to edit_event_path(@event), class: "mw-btn mw-btn--secondary mw-btn--sm" do
        = lucide_icon "pencil", size: 14
        Bearbeiten
    = link_to "Zurück", events_path, class: "mw-page-action"

.mw-card{ style: "margin-top: 1.5rem; max-width: 560px;" }
  .mw-detail-list
    .mw-detail-row
      .mw-detail-row__icon= lucide_icon "calendar", size: 18
      .mw-detail-row__content
        .mw-detail-row__label Datum & Uhrzeit
        .mw-detail-row__value
          = l(@event.start_date, format: :long)
          - unless @event.all_day
            %span.mw-text-muted{ style: "margin-left: 0.4rem;" }
              = lucide_icon "clock", size: 14
              = @event.start_time

    - if @event.location.present?
      .mw-detail-row
        .mw-detail-row__icon= lucide_icon "map-pin", size: 18
        .mw-detail-row__content
          .mw-detail-row__label Ort
          .mw-detail-row__value= @event.location

    - if @event.address.present?
      .mw-detail-row
        .mw-detail-row__icon= lucide_icon "map-pin", size: 18, class: "mw-icon lucide-map-pin"
        .mw-detail-row__content
          .mw-detail-row__label Adresse
          .mw-detail-row__value= @event.address

    .mw-detail-row
      .mw-detail-row__icon= lucide_icon "layout-grid", size: 18
      .mw-detail-row__content
        .mw-detail-row__label Gruppen
        .mw-detail-row__value
          .mw-group-chips
            - @event.groups.each do |g|
              %span.mw-badge.mw-badge--neutral= g.name

    - if @event.description.present?
      .mw-detail-row
        .mw-detail-row__icon{ style: "padding-top: 2px;" }
        .mw-detail-row__content
          .mw-detail-row__label Beschreibung
          .mw-detail-row__value.mw-prose= simple_format(@event.description)

- if @event.address.present?
  - encoded_address = CGI.escape(@event.address)
  .mw-event-map{ style: "margin-top: 1.25rem; max-width: 560px;" }
    %p.mw-text-muted{ style: "margin-bottom: 0.5rem;" } Standort
    .mw-event-map__frame{ style: "position: relative; padding-top: 56.25%; border-radius: var(--radius-lg, 16px); overflow: hidden; border: 1px solid var(--border-subtle);" }
      %iframe{ src: "https://www.google.com/maps?q=#{encoded_address}&output=embed",
               loading: "lazy", referrerpolicy: "no-referrer-when-downgrade",
               style: "position: absolute; inset: 0; width: 100%; height: 100%; border: 0;",
               title: "Karte zur Adresse #{@event.address}" }
    = link_to "https://www.google.com/maps?q=#{encoded_address}", target: "_blank", rel: "noopener",
        class: "mw-page-action", style: "margin-top: 0.5rem;" do
      = lucide_icon "arrow-right", size: 14
      In Google Maps öffnen
