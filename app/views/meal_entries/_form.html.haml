= form_with model: meal_entry, url: meal_entry.new_record? ? meal_entries_path : meal_entry_path(meal_entry), class: "mw-form", html: { id: "meal_entry_form" } do |f|
  - if meal_entry.errors.any?
    .mw-flash.mw-flash--error
      %ul{ style: "margin: 0; padding-left: 1.25rem;" }
        - meal_entry.errors.full_messages.each do |msg|
          %li= msg

  .mw-field-row
    .mw-field
      = f.label :date, "Datum", class: "mw-field__label"
      = f.date_field :date, required: true, class: "mw-input"
    .mw-field
      = f.label :group_id, "Gruppe", class: "mw-field__label"
      = f.select :group_id,
          options_from_collection_for_select(groups, :id, :name, meal_entry.group_id),
          { include_blank: "Bitte wählen" }, class: "mw-select", required: true

  .mw-field
    = f.label :kindergarten_year_id, "Kindergartenjahr", class: "mw-field__label"
    = f.select :kindergarten_year_id,
        options_from_collection_for_select(kindergarten_years, :id, :label, meal_entry.kindergarten_year_id),
        { include_blank: "Bitte wählen" }, class: "mw-select", required: true

  -# F34: Vier Course-Slots in fester Reihenfolge. Leere Slots werden serverseitig
  -# via reject_if verworfen; mindestens eine Speise ist Pflicht.
  .mw-meal-courses
    %p.mw-field__hint{ style: "margin-bottom: 0.75rem;" }
      Erfasse pro Tag, was es gibt. Leere Felder werden ignoriert.
      Mindestens eine Speise ist Pflicht.
    - meal_entry.courses_by_type.each_with_index do |course, idx|
      = f.fields_for :meal_courses, course, child_index: idx do |course_form|
        - if course.persisted?
          = course_form.hidden_field :id
        = course_form.hidden_field :course_type, value: course.course_type
        = course_form.hidden_field :position,    value: idx

        .mw-meal-course
          .mw-meal-course__label= course.label
          .mw-meal-course__row
            = course_form.text_field :name, class: "mw-input mw-meal-course__name",
                placeholder: course.starter? ? "z. B. Tomatensuppe" : (course.dessert? ? "z. B. Apfelmus" : (course.extra? ? "z. B. Vollkornbrot" : "z. B. Spaghetti Bolognese")),
                autofocus: idx == 1
            .mw-meal-course__diet
              - MealCourse::DIETARY_VALUES.each do |val|
                %label.mw-radio-pill
                  = course_form.radio_button :dietary, val
                  %span= MealCourse::DIETARY_LABELS[val]

  .mw-field
    = f.label :notes, "Hinweise (optional)", class: "mw-field__label"
    = f.text_area :notes, rows: 2, class: "mw-input",
        placeholder: "z. B. Sommerfest-Buffet, Geburtstag o. ä."
