- content_for :title, "Speiseplan · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Speiseplan
    %p.mw-page-header__lede
      KW #{@week_start.cweek} · #{l(@week_start, format: :short)} – #{l(@week_start + 4.days, format: :short)}
  .mw-page-header__actions
    = link_to meal_entries_path(week: (@week_start - 7).iso8601), class: "mw-page-action" do
      = lucide_icon "chevron-left", size: 14
      Vorherige Woche
    = link_to meal_entries_path, class: "mw-page-action" do
      Heute
    = link_to meal_entries_path(week: (@week_start + 7).iso8601), class: "mw-page-action" do
      Nächste Woche
      = lucide_icon "chevron-right", size: 14
    - if current_user.staff?
      = link_to new_meal_entry_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Eintrag anlegen

- if notice
  .mw-flash.mw-flash--success= notice

- if @groups.any?
  .mw-card{ style: "margin-top: 1.5rem; overflow-x: auto;" }
    %table.mw-table.mw-table--cards{ style: "width: 100%; min-width: 720px;" }
      %thead
        %tr
          %th{ style: "width: 140px;" } Speiseplan
          - @week_days.each do |day|
            %th{ style: "text-align: left;" }
              = I18n.l(day, format: "%A").first(2)
              %br
              %span{ style: "font-weight: normal; color: var(--fg-2);" }= l(day, format: :short)

      - @groups.each do |group|
        - day_entries = @week_days.map { |day| [ day, @entries_by_day_group[[day, group.id]] ] }
        - has_any_notes = day_entries.any? { |_, e| e&.notes.present? }

        %tbody
          %tr.mw-meal-row__group-header
            %td{ colspan: 6 }
              = link_to print_meal_entries_path(group_id: group.id, week: @week_start.iso8601),
                  target: "_blank", rel: "noopener",
                  class: "mw-page-action",
                  title: "Speiseplan dieser Gruppe drucken",
                  style: "float: right; padding: 2px 8px; font-size: var(--fs-12);" do
                = lucide_icon "printer", size: 12
                Drucken
              %strong= group.name

          - MealCourse::COURSE_TYPES.each do |type|
            %tr.mw-meal-row
              %td.mw-meal-row__label{ "data-label": "Course" }= MealCourse::COURSE_LABELS[type]
              - day_entries.each do |day, entry|
                %td.mw-meal-cell{ "data-label": I18n.l(day, format: "%A") }
                  - course = entry&.meal_courses&.detect { |c| c.course_type == type }
                  - if course
                    %span.mw-meal-cell__name
                      = course.name
                      = diet_icon(course)
                  - else
                    %span.mw-meal-cell__empty –

          - if has_any_notes
            %tr.mw-meal-row
              %td.mw-meal-row__label{ "data-label": "Notiz" } Notiz
              - day_entries.each do |day, entry|
                %td.mw-meal-cell{ "data-label": "Notiz #{I18n.l(day, format: "%a")}" }
                  - if entry&.notes.present?
                    %span.mw-meal-cell__notes= entry.notes

          - if current_user.staff?
            %tr.mw-meal-row
              %td.mw-meal-row__label{ "data-label": "Aktionen" } Aktionen
              - day_entries.each do |day, entry|
                %td.mw-meal-cell{ "data-label": "Aktionen #{I18n.l(day, format: "%a")}" }
                  - if entry
                    .mw-actions{ style: "gap: 0.25rem;" }
                      = link_to edit_meal_entry_path(entry),
                          class: "mw-btn mw-btn--ghost mw-btn--xs",
                          title: "Bearbeiten", "aria-label": "Bearbeiten" do
                        = lucide_icon "pencil", size: 12
                      = button_to meal_entry_path(entry), method: :delete,
                          class: "mw-btn mw-btn--ghost mw-btn--xs",
                          title: "Löschen", "aria-label": "Löschen",
                          data: { turbo_confirm: "Eintrag löschen?" } do
                        = lucide_icon "trash-2", size: 12
                  - else
                    = link_to new_meal_entry_path(date: day.iso8601, group_id: group.id),
                        class: "mw-btn mw-btn--ghost mw-btn--xs",
                        style: "color: var(--fg-3); width: 100%;",
                        title: "Eintrag für #{l(day, format: :short)} anlegen" do
                      = lucide_icon "plus", size: 12
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    %p.mw-text-muted Keine Gruppen verfügbar.
