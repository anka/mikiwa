- content_for :title, "Speiseplan-Eintrag bearbeiten · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Speiseplan-Eintrag bearbeiten
  .mw-page-header__actions
    = link_to "Abbrechen", meal_entries_path(week: @meal_entry.date&.iso8601), class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "meal_entry_form" }
      = lucide_icon "check", size: 14
      Speichern

= render "form", meal_entry: @meal_entry, groups: @groups, kindergarten_years: @kindergarten_years
