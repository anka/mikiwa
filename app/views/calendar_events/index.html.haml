- content_for :title, "Kalender · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Kalender
    - if @filter_year
      %p.mw-page-header__lede= @filter_year.label
  - if current_user.staff?
    .mw-page-header__actions
      = link_to new_calendar_event_path, class: "mw-btn mw-btn--primary mw-btn--sm" do
        = lucide_icon "plus", size: 16
        Neues Ereignis

- if notice
  .mw-flash.mw-flash--success= notice

= render "filters"

- if @view == "month"
  = render "month_view"
- else
  = render "list_view"
