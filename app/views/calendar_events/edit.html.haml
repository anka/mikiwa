- content_for :title, "#{@event.title} bearbeiten · Kalender · Mikiwa"

.mw-page-header
  .mw-page-header__text
    %h1.mw-page-header__title Ereignis bearbeiten
  .mw-page-header__actions
    = link_to "Abbrechen", calendar_event_path(@event), class: "mw-page-action"
    %button.mw-btn.mw-btn--primary.mw-btn--sm{ type: "submit", form: "calendar_event_form" }
      = lucide_icon "check", size: 14
      Speichern

= render "form", event: @event, groups: @groups, kindergarten_years: @kindergarten_years
