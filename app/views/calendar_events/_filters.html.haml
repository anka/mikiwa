- year_default_id  = @current_year&.id
- year_active      = @filter_year && @filter_year.id != year_default_id
- active_count     = [ @filter_q.presence, @filter_group_id.presence, (year_active ? @filter_year.id : nil) ].compact.size
- clear_url        = calendar_events_path(view: @view)

= form_with url: calendar_events_path, method: :get, local: true, class: "mw-filters" do
  = hidden_field_tag :view, @view
  .mw-filters__row
    .mw-filters__search
      = lucide_icon "search", size: 16, class: "mw-filters__search-icon"
      = text_field_tag :q, @filter_q,
          id: "filter-q",
          placeholder: "Ereignis suchen …",
          autocomplete: "off",
          class: "mw-input mw-filters__search-input"
      - if @filter_q.present?
        - clear_q = { view: @view, kindergarten_year_id: (year_active ? @filter_year.id : nil), group_id: @filter_group_id }.compact_blank
        = link_to "#{calendar_events_path}?#{clear_q.to_query}",
            class: "mw-filters__clear",
            "aria-label": "Suchtext löschen", title: "Suchtext löschen" do
          = lucide_icon "x", size: 14

    = select_tag :kindergarten_year_id,
                 options_from_collection_for_select(@kindergarten_years, :id, :label, @filter_year&.id),
                 include_blank: "Alle Jahre",
                 class: "mw-select mw-filters__select",
                 onchange: "this.form.requestSubmit()"

    = select_tag :group_id,
                 options_from_collection_for_select(@groups, :id, :name, @filter_group_id),
                 include_blank: "Alle Gruppen",
                 class: "mw-select mw-filters__select",
                 onchange: "this.form.requestSubmit()"

    .mw-filters__actions
      = submit_tag "Filtern", class: "mw-btn mw-btn--primary mw-btn--sm"
      - if active_count.positive?
        = link_to clear_url, class: "mw-page-action mw-filters__reset" do
          = lucide_icon "rotate-ccw", size: 14
          Zurücksetzen
          %span.mw-badge.mw-badge--accent.mw-filters__reset-count= active_count

    .mw-calendar-filters__views
      = link_to calendar_events_path(view: "month", kindergarten_year_id: @filter_year&.id, group_id: @filter_group_id, q: @filter_q.presence, month: params[:month]),
          class: "mw-btn mw-btn--sm #{@view == 'month' ? 'mw-btn--primary' : 'mw-btn--secondary'}" do
        = lucide_icon "calendar", size: 14
        Monat
      = link_to calendar_events_path(view: "list", kindergarten_year_id: @filter_year&.id, group_id: @filter_group_id, q: @filter_q.presence),
          class: "mw-btn mw-btn--sm #{@view == 'list' ? 'mw-btn--primary' : 'mw-btn--secondary'}" do
        = lucide_icon "list", size: 14
        Liste
