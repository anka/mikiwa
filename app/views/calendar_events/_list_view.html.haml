- combined = []
- @events.each { |e| combined << { date: e.start_date, kind: :event, payload: e } }
- (@birthday_entries || []).each { |b| combined << { date: b.date, kind: :birthday, payload: b } }
- combined.sort_by! { |row| row[:date] }

- if combined.any?
  .mw-card{ style: "margin-top: 1.5rem;" }
    %table.mw-table{ style: "width: 100%;" }
      %thead
        %tr
          %th Datum
          %th Titel
          %th Gruppen
          %th Ort
          - if current_user.staff?
            %th{ style: "text-align: right;" } Aktionen
      %tbody
        - combined.each do |row|
          - if row[:kind] == :birthday
            - birthday = row[:payload]
            %tr
              %td{ style: "white-space: nowrap;" }= l(birthday.date, format: :long)
              %td
                .mw-event-title
                  %span.mw-badge.mw-badge--birthday{ style: "margin-right: 0.4rem;" }
                    = lucide_icon "cake", size: 12
                    Geburtstag
                  = link_to birthday.title, child_path(birthday.child), class: "mw-link"
                  %span.mw-text-muted{ style: "margin-left: 0.5rem; font-size: 0.85em;" }
                    wird #{birthday.new_age} Jahre
              %td= birthday.child.group.name
              %td –
              - if current_user.staff?
                %td
          - else
            - event = row[:payload]
            %tr
              %td{ style: "white-space: nowrap;" }
                - if event.all_day
                  = l(event.start_date, format: :long)
                - else
                  = l(event.start_date, format: :long)
                  %span.mw-text-muted{ style: "margin-left: 0.25rem; font-size: 0.85em;" }
                    = lucide_icon "clock", size: 12
                    = event.start_time
              %td
                .mw-event-title
                  - if event.event_type == "veranstaltung"
                    %span.mw-badge.mw-badge--accent{ style: "margin-right: 0.4rem;" } Veranstaltung
                  = link_to event.title, calendar_event_path(event), class: "mw-link"
              %td
                .mw-group-chips
                  - event.groups.each do |g|
                    %span.mw-badge.mw-badge--neutral= g.name
              %td= event.location.presence || "–"
              - if current_user.staff?
                %td{ style: "text-align: right;" }
                  .mw-actions
                    = link_to edit_calendar_event_path(event), class: "mw-page-action", title: "Bearbeiten" do
                      = lucide_icon "pencil", size: 14
                    = button_to calendar_event_path(event), method: :delete,
                        class: "mw-page-action mw-page-action--danger",
                        title: "Löschen",
                        data: { turbo_confirm: "Ereignis \"#{event.title}\" wirklich löschen?" } do
                      = lucide_icon "trash-2", size: 14
- else
  .mw-empty-state{ style: "margin-top: 2rem;" }
    = image_tag "mikiwa/illustration-empty.svg", style: "width: 120px; opacity: 0.55;", alt: ""
    %p.mw-text-muted Keine Ereignisse für diesen Zeitraum.
    - if current_user.staff?
      = link_to "Erstes Ereignis anlegen", new_calendar_event_path, class: "mw-btn mw-btn--primary mw-btn--sm"
